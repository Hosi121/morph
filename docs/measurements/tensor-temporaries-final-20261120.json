  "independent_fraction_reference_source": "from fractions import Fraction as F\nfrom itertools import product\n\ndef geometry_expected(case):\n n,count={'tiny':(1,10000),'zero':(0,10000),'raise3':(3,2000),'raise5':(5,500),'scalar3':(3,1000),'scalar5':(5,500)}[case]\n m=n+1\n def g(i,j):return F(m*(i==j)-1,m*m)\n def lower(i,j,k):return F(0) if i==j==k else F(m*m,2)\n def ricci(i,j):return F((n-1)*m*(1+(i==j)),4)\n def tensor(rank,term):\n  return dict(shape=[n]*rank,entries=[[x.numerator,x.denominator] for ix in product(range(n),repeat=rank) for x in [term(*ix)]])\n return dict(case=case,dimension=n,iterations=count*32,checked=True,\n  inverse=tensor(2,g),lower=tensor(3,lower),ricci=tensor(2,ricci),\n  raised=tensor(3,lambda i,j,k:sum((g(k,a)*lower(i,j,a) for a in range(n)),F(0))),\n  product=tensor(4,lambda i,j,k,l:g(i,j)*ricci(k,l)),\n  first_trace=tensor(2,lambda j,l:sum((g(i,j)*ricci(i,l) for i in range(n)),F(0))),\n  scalar=dict(shape=[],entries=[[F(n*(n-1),4).numerator,F(n*(n-1),4).denominator]]))\n",
