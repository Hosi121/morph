///|
test "grouped wide loops match the independent integer quotient and remainder" {
  for a in 0..<128 {
    for b in 1..<128 {
      let xs = @oracle.binary(a).bits
      let divisor = @oracle.binary(b)
      let q = @oracle.binary(a / b)
      let r = @oracle.binary(a % b)
      assert_eq(wide_group_2_remainder(xs, divisor), r)
      assert_eq(wide_group_2_divide(xs, divisor), (q, r))
      assert_eq(wide_group_4_remainder(xs, divisor), r)
      assert_eq(wide_group_4_divide(xs, divisor), (q, r))
      assert_eq(wide_group_8_remainder(xs, divisor), r)
      assert_eq(wide_group_8_divide(xs, divisor), (q, r))
    }
  }
}

///|
test "unrolled reverse loops and native ownership controls" (b : @bench.T) {
  for (width, modulus) in [(128, 3), (512, 31), (4096, 3)] {
    let word = pair(@oracle.nat(width), @oracle.binary(5))
    let divisor = @oracle.binary(modulus)
    b.bench(name="recursive rem \{width}", fn() {
      b.keep(remainder_bits(word.bits, divisor))
    })
    b.bench(name="reverse rem \{width}", fn() {
      b.keep(reversed_remainder_bits(word.bits, divisor))
    })
    b.bench(name="recursive div \{width}", fn() {
      b.keep(divide_bits(word.bits, divisor))
    })
    b.bench(name="group2 remainder \{width}", fn() {
      b.keep(wide_group_2_remainder(word.bits, divisor))
    })
    b.bench(name="group2 divide \{width}", fn() {
      b.keep(wide_group_2_divide(word.bits, divisor))
    })
    b.bench(name="group4 remainder \{width}", fn() {
      b.keep(wide_group_4_remainder(word.bits, divisor))
    })
    b.bench(name="group4 divide \{width}", fn() {
      b.keep(wide_group_4_divide(word.bits, divisor))
    })
    b.bench(name="group8 remainder \{width}", fn() {
      b.keep(wide_group_8_remainder(word.bits, divisor))
    })
    b.bench(name="group8 divide \{width}", fn() {
      b.keep(wide_group_8_divide(word.bits, divisor))
    })
  }
}
