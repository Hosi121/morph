///|
fn wide_group_2_remainder_loop(
  xs : @core.Chain[Bool],
  divisor : Binary,
  r : Binary,
) -> Binary {
  match xs {
    Nil => r
    Cons(b0, Cons(b1, tail)) => {
      let next0 = Binary::{ bits: low_bit(b0, r.bits), }
      let order0 = compare(next0, divisor)
      let r0 = match order0 {
        Less => next0
        Equal => zero()
        _ => from_bits(subtract_bits(next0.bits, divisor.bits, false))
      }
      let next1 = Binary::{ bits: low_bit(b1, r0.bits), }
      let order1 = compare(next1, divisor)
      let r1 = match order1 {
        Less => next1
        Equal => zero()
        _ => from_bits(subtract_bits(next1.bits, divisor.bits, false))
      }
      wide_group_2_remainder_loop(tail, divisor, r1)
    }
    Cons(b0, tail) => {
      let next0 = Binary::{ bits: low_bit(b0, r.bits), }
      let order0 = compare(next0, divisor)
      let r0 = match order0 {
        Less => next0
        Equal => zero()
        _ => from_bits(subtract_bits(next0.bits, divisor.bits, false))
      }
      wide_group_2_remainder_loop(tail, divisor, r0)
    }
  }
}

///|
fn wide_group_2_remainder(xs : @core.Chain[Bool], divisor : Binary) -> Binary {
  wide_group_2_remainder_loop(@core.reverse(xs), divisor, zero())
}

