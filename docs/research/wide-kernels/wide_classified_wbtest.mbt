///|
fn classified_wide_remainder(
  xs : @core.Chain[Bool],
  divisor : Binary,
) -> Binary {
  match wide_has_long_tail(xs) {
    true => raw_wide_remainder(xs, divisor)
    false => remainder_bits(xs, divisor)
  }
}

///|
test "wide classifier and tail kernel cover bounded and deep inputs" {
  for n in [0, 1, 127, 128, 255, 256, 257, 4096, 20000] {
    let xs = @core.replicate(@oracle.nat(n), false)
    assert_eq(wide_has_long_tail(xs), n >= 256)
  }
  let word = pair(@oracle.nat(20000), zero())
  assert_eq(classified_wide_remainder(word.bits, @oracle.binary(3)), one())
}

///|
test "bounded shape discriminator preserves ordinary remainder controls" (
  b : @bench.T,
) {
  for (width, denominator) in [(128, 3), (512, 31), (4096, 3)] {
    let word = pair(@oracle.nat(width), @oracle.binary(5))
    let divisor = @oracle.binary(denominator)
    b.bench(name="old rem \{width}", fn() {
      b.keep(remainder_bits(word.bits, divisor))
    })
    b.bench(name="class rem \{width}", fn() {
      b.keep(classified_wide_remainder(word.bits, divisor))
    })
  }
}
