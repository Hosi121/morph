diff --git a/src/gf2/basis.mbt b/src/gf2/basis.mbt
new file mode 100644
index 0000000..3b7348d
--- /dev/null
+++ b/src/gf2/basis.mbt
@@ -0,0 +1,67 @@
+///|
+/// Coefficients arrive in pivot-row order for one free column. No row nth is
+/// needed while emitting the full variable-ordered basis vector.
+fn prepared_basis_vector(
+  columns : @core.Chain[@core.Nat],
+  pairs : @core.Chain[(@core.Nat, @core.Chain[Bool])],
+  coefficients : @core.Chain[Bool],
+  free_column : @core.Nat,
+) -> @core.Chain[Bool] {
+  match (columns, pairs) {
+    (Nil, _) => Nil
+    (Cons(column, rest), Nil) =>
+      Cons(
+        column.equal(free_column),
+        prepared_basis_vector(rest, Nil, coefficients, free_column),
+      )
+    (Cons(column, rest), Cons((pivot, _), tail)) =>
+      match @core.compare(column, pivot) {
+        Less =>
+          Cons(
+            column.equal(free_column),
+            prepared_basis_vector(rest, pairs, coefficients, free_column),
+          )
+        Equal =>
+          match coefficients {
+            Cons(value, values) =>
+              Cons(
+                value,
+                prepared_basis_vector(rest, tail, values, free_column),
+              )
+            Nil =>
+              Cons(false, prepared_basis_vector(rest, tail, Nil, free_column))
+          }
+        Greater =>
+          match coefficients {
+            Cons(_, values) =>
+              prepared_basis_vector(columns, tail, values, free_column)
+            Nil => prepared_basis_vector(columns, tail, Nil, free_column)
+          }
+      }
+  }
+}
+
+///|
+/// Walk the prepared columns and ascending free indices together. Only the
+/// source width is prepared, so an augmented solve's RHS cannot enter a basis.
+fn prepared_basis(
+  coefficients : @core.Chain[@core.Chain[Bool]],
+  remaining : @core.Chain[@core.Nat],
+  free : @core.Chain[@core.Nat],
+  columns : @core.Chain[@core.Nat],
+  pairs : @core.Chain[(@core.Nat, @core.Chain[Bool])],
+) -> @core.Chain[@core.Chain[Bool]] {
+  match (coefficients, remaining, free) {
+    (_, _, Nil) | (Nil, _, _) | (_, Nil, _) => Nil
+    (Cons(values, rest), Cons(index, indices), Cons(variable, tail)) =>
+      match @core.compare(index, variable) {
+        Less => prepared_basis(rest, indices, free, columns, pairs)
+        Equal =>
+          Cons(
+            prepared_basis_vector(columns, pairs, values, variable),
+            prepared_basis(rest, indices, tail, columns, pairs),
+          )
+        Greater => prepared_basis(coefficients, remaining, tail, columns, pairs)
+      }
+  }
+}
diff --git a/src/gf2/late_basis_wbtest.mbt b/src/gf2/late_basis_wbtest.mbt
new file mode 100644
index 0000000..2de3fff
--- /dev/null
+++ b/src/gf2/late_basis_wbtest.mbt
@@ -0,0 +1,113 @@
+///|
+fn late_basis_old_vector(
+  columns : @core.Chain[@core.Nat],
+  pairs : @core.Chain[(@core.Nat, @core.Chain[Bool])],
+  free_column : @core.Nat,
+) -> @core.Chain[Bool] {
+  match (columns, pairs) {
+    (Nil, _) => Nil
+    (Cons(column, rest), Nil) =>
+      Cons(
+        column.equal(free_column),
+        late_basis_old_vector(rest, Nil, free_column),
+      )
+    (Cons(column, rest), Cons((pivot, row), tail)) =>
+      match @core.compare(column, pivot) {
+        Less =>
+          Cons(
+            column.equal(free_column),
+            late_basis_old_vector(rest, pairs, free_column),
+          )
+        Equal =>
+          Cons(
+            @core.nth(row, free_column).equal(Some(true)),
+            late_basis_old_vector(rest, tail, free_column),
+          )
+        Greater => late_basis_old_vector(columns, tail, free_column)
+      }
+  }
+}
+
+///|
+fn late_basis_old_nullspace(
+  width : @core.Nat,
+  pairs : @core.Chain[(@core.Nat, @core.Chain[Bool])],
+) -> @core.Chain[@core.Chain[Bool]] {
+  let columns = @core.indices(width)
+  @core.map(free_columns(columns, pairs), fn(free_column) {
+    late_basis_old_vector(columns, pairs, free_column)
+  })
+}
+
+///|
+test "late prepared basis matches frozen row nth on sparse dense and rank boundaries" {
+  for
+    (height, width) in [
+      (0, 0),
+      (0, 11),
+      (7, 0),
+      (1, 3),
+      (8, 32),
+      (16, 32),
+      (24, 12),
+    ] {
+    for seed in 0..<5 {
+      let rows = Array::makei(height, fn(i) {
+        Array::makei(width, fn(j) {
+          if seed == 0 {
+            false
+          } else if seed == 1 {
+            i == j
+          } else if seed == 2 {
+            j == i * 3 || j == 25 + i % 7
+          } else {
+            ((i + 1) * 197 + (j + 1) * 269 + i * j * 137 + seed) % 521 % 2 == 0
+          }
+        })
+      })
+      let source = input(width, rows)
+      let factor = factor(source).unwrap()
+      let reduced = reduction(factor)
+      let pairs = @core.zip(
+        reduced.pivots,
+        @core.take(@core.length(reduced.pivots), @matrix.rows(reduced.matrix)),
+      ).unwrap()
+      let expected = late_basis_old_nullspace(@oracle.nat(width), pairs)
+      assert_eq(nullspace_factor(factor), expected)
+      let homogeneous = @rowreduce.solve(
+        field(),
+        source,
+        @core.replicate(@oracle.nat(height), false),
+      ).unwrap()
+      let host_expected = match homogeneous {
+        Affine(_, basis) => basis
+        Unique(_) => @core.Nil
+        Inconsistent => abort("homogeneous inconsistency")
+      }
+      assert_eq(expected, host_expected)
+    }
+  }
+}
+
+///|
+test "late coefficient layout ignores augmented RHS and preserves all small affine solves" {
+  for height in 0..<=2 {
+    for width in 0..<=3 {
+      for bits in 0..<(1 << (height * width)) {
+        let rows = Array::makei(height, fn(i) {
+          Array::makei(width, fn(j) { (bits & (1 << (i * width + j))) != 0 })
+        })
+        let source = input(width, rows)
+        let factor = factor(source).unwrap()
+        for rhs_bits in 0..<(1 << height) {
+          let rhs = @oracle.chain(
+            Array::makei(height, fn(i) { (rhs_bits & (1 << i)) != 0 }),
+          )
+          let expected = @rowreduce.solve(field(), source, rhs)
+          assert_eq(solve(source, rhs), expected)
+          assert_eq(solve_factor(factor, rhs), expected)
+        }
+      }
+    }
+  }
+}
