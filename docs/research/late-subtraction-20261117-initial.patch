diff --git a/src/polynomial/subtraction.mbt b/src/polynomial/subtraction.mbt
new file mode 100644
index 0000000..51f9659
--- /dev/null
+++ b/src/polynomial/subtraction.mbt
@@ -0,0 +1,41 @@
+///|
+/// Subtract sorted canonical term lists without materializing a negated input.
+/// A right-only term is negated only when it becomes part of the output.
+fn merge_subtract(
+  a : @core.Chain[Term],
+  b : @core.Chain[Term],
+) -> @core.Chain[Term] {
+  match (a, b) {
+    (Nil, _) =>
+      @core.map(b, fn(term) {
+        {
+          coefficient: @exact.rational_negate(term.coefficient),
+          exponents: term.exponents,
+        }
+      })
+    (_, Nil) => a
+    (Cons(x, xt), Cons(y, yt)) =>
+      match compare_monomial(x.exponents, y.exponents) {
+        Greater => Cons(x, merge_subtract(xt, b))
+        Less =>
+          Cons(
+            {
+              coefficient: @exact.rational_negate(y.coefficient),
+              exponents: y.exponents,
+            },
+            merge_subtract(a, yt),
+          )
+        Equal => {
+          let combined : Term = {
+            coefficient: @exact.rational_subtract(x.coefficient, y.coefficient),
+            exponents: x.exponents,
+          }
+          let rest = merge_subtract(xt, yt)
+          match nonzero(combined) {
+            true => Cons(combined, rest)
+            false => rest
+          }
+        }
+      }
+  }
+}
