    [(863, 128), (6, 1), (1, 1)],
    (-4, 1),
    (1, 8),
  )
}

///|
test "Independent number field minimal polynomial and real root fixture 63" {
  assert_real_fixture(
    [(-1, 2), (0, 1), (1, 1)],
    (0, 1),
    (1, 1),
    [(-3, 1)],
    [(3, 1), (1, 1)],
    (-4, 1),
    (-2, 1),
  )
}
