///|
#derive(Eq, Debug)
pub struct FiniteGroup {
  priv degree : @core.Nat
  priv generators : @core.Chain[Permutation]
  priv members : @avl.OrderedMap[Permutation, Unit]
}

///|
pub extend FiniteGroup with Eq::{equal, not_equal}

///|
pub extend FiniteGroup with Debug::{to_repr}

///|
/// A paused breadth-first closure. Its payload cannot be forged by callers.
#derive(Eq, Debug)
pub struct GenerationState {
  priv group : FiniteGroup
  priv frontier : @core.Queue[Permutation]
}

///|
pub extend GenerationState with Eq::{equal, not_equal}

///|
pub extend GenerationState with Debug::{to_repr}

///|
#derive(Eq, Debug)
pub(all) enum Generation {
  InvalidGenerators
  Pending(GenerationState)
  Complete(FiniteGroup)
}

///|
pub extend Generation with Eq::{equal, not_equal}

///|
pub extend Generation with Debug::{to_repr}

///|
fn keys(tree : @avl.OrderedMap[Permutation, Unit]) -> @core.Chain[Permutation] {
  @core.map(@avl.entries(tree), fn(entry) {
    let (key, _) = entry
    key
  })
}

///|
fn permutation_set(
  values : @core.Chain[Permutation],
) -> @avl.OrderedMap[Permutation, Unit] {
  @core.fold_left(values, @avl.empty(), fn(tree, value) {
    @avl.put(tree, value, (), compare)
  })
}

///|
pub fn group_degree(group : FiniteGroup) -> @core.Nat {
  group.degree
}

///|
/// Sorted, duplicate-free generators. Their input order has no semantic role.
pub fn group_generators(group : FiniteGroup) -> @core.Chain[Permutation] {
  group.generators
}

///|
/// All elements in lexicographic order on their images.
pub fn group_elements(group : FiniteGroup) -> @core.Chain[Permutation] {
  keys(group.members)
}

///|
pub fn order(group : FiniteGroup) -> @core.Nat {
  @core.length(group_elements(group))
}

///|
pub fn contains(group : FiniteGroup, value : Permutation) -> Bool {
  group.degree.equal(value.degree) &&
  (@avl.lookup(group.members, value, compare) is Some(_))
}

///|
fn extend_frontier(state : GenerationState, element : Permutation) -> GenerationState {
  @core.fold_left(state.group.generators, state, fn(current, generator) {
    let product = compose_same(element, generator)
    if contains(current.group, product) {
      current
    } else {
      {
        group: {
          ..current.group,
          members: @avl.put(current.group.members, product, (), compare),
        },
        frontier: @core.enqueue(current.frontier, product),
      }
    }
  })
}

///|
/// Each unit of fuel processes one discovered element against every generator.
/// Exhaustion preserves the exact frontier and never asserts completion.
pub fn resume_generation(state : GenerationState, fuel : @core.Nat) -> Generation {
  match @core.dequeue(state.frontier) {
    None => Complete(state.group)
    Some((element, rest)) =>
      match fuel {
        Zero => Pending(state)
        Succ(remaining) =>
          resume_generation(extend_frontier({ ..state, frontier: rest, }, element), remaining)
      }
  }
}

///|
/// Enumerate the subgroup generated by checked permutations of this degree.
/// A finite submonoid of a permutation group is a subgroup, so generator
/// inverses need not be inserted separately into the breadth-first frontier.
pub fn generate(
  degree : @core.Nat,
  generators : @core.Chain[Permutation],
  fuel : @core.Nat,
) -> Generation {
  if !@core.all(generators, fn(value) {
      value.degree.equal(degree) && valid_permutation(value)
    }) {
    return InvalidGenerators
  }
  let unit = identity(degree)
  let group : FiniteGroup = {
    degree,
    generators: keys(permutation_set(generators)),
    members: @avl.put(@avl.empty(), unit, (), compare),
  }
  resume_generation({ group, frontier: @core.enqueue(@core.queue(), unit), }, fuel)
}

///|
pub fn same_group(left : FiniteGroup, right : FiniteGroup) -> Bool {
  left.degree.equal(right.degree) &&
  group_elements(left).equal(group_elements(right))
}

///|
/// Both operands are already complete groups of the same point set.
pub fn is_subgroup(subgroup : FiniteGroup, group : FiniteGroup) -> Bool {
  subgroup.degree.equal(group.degree) &&
  @core.all(group_elements(subgroup), fn(value) { contains(group, value) })
}

///|
pub fn is_normal(subgroup : FiniteGroup, group : FiniteGroup) -> Bool {
  is_subgroup(subgroup, group) &&
  @core.all(group_elements(group), fn(g) {
    @core.all(group_elements(subgroup), fn(h) {
      contains(subgroup, compose_same(compose_same(g, h), inverse(g)))
    })
  })
}

///|
pub fn is_abelian(group : FiniteGroup) -> Bool {
  let elements = group_elements(group)
  @core.all(elements, fn(left) {
    @core.all(elements, fn(right) {
      compose_same(left, right).equal(compose_same(right, left))
    })
  })
}

///|
// All states here are private checked permutations of a finite point set.
// Hence at most degree factorial distinct elements can enter this frontier.
fn finish(state : GenerationState) -> FiniteGroup {
  match @core.dequeue(state.frontier) {
    None => state.group
    Some((element, rest)) =>
      finish(extend_frontier({ ..state, frontier: rest, }, element))
  }
}

///|
/// Generate from every pair commutator, not merely the raw commutator set.
/// This exact operation is intended for explicitly enumerated small groups.
pub fn derived_subgroup(group : FiniteGroup) -> FiniteGroup {
  let elements = group_elements(group)
  let commutators = @core.fold_left(elements, @avl.empty(), fn(tree, left) {
    @core.fold_left(elements, tree, fn(current, right) {
      @avl.put(current, commutator_same(left, right), (), compare)
    })
  })
  let unit = identity(group.degree)
  finish({
    group: {
      degree: group.degree,
      generators: keys(commutators),
      members: @avl.put(@avl.empty(), unit, (), compare),
    },
    frontier: @core.enqueue(@core.queue(), unit),
  })
}
