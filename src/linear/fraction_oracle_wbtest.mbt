// Generated by tools/generate_rational_elimination_cases.py; independent Python Fraction oracle.

///|
fn fraction_vector(
  values : Array[(Int32, Int32)],
) -> @core.Chain[@exact.Rational] {
  @oracle.chain(values.map(fn(value) { @oracle.rational(value.0, value.1) }))
}

///|
fn fraction_matrix(
  values : Array[Array[(Int32, Int32)]],
  width : Int32,
) -> @matrix.Matrix[@exact.Rational] {
  @matrix.matrix(@oracle.nat(width), @oracle.chain(values.map(fraction_vector))).unwrap()
}

