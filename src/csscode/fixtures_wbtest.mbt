  assert_eq(validate(masks(3, [3, 5]), masks(3, [5])), None)
  assert_eq(validate(masks(3, [3, 5]), masks(3, [6])), None)
  verify_fixture(3, [3, 5], [7], [2, 1, 0, -1, -1], [105, 129, 0, 0])
  assert_eq(validate(masks(3, [3, 5]), masks(3, [1, 2])), None)
  assert_eq(validate(masks(3, [3, 5]), masks(3, [1, 4])), None)
  assert_eq(validate(masks(3, [3, 5]), masks(3, [1, 6])), None)
  assert_eq(validate(masks(3, [3, 5]), masks(3, [2, 4])), None)
  assert_eq(validate(masks(3, [3, 5]), masks(3, [2, 5])), None)
  assert_eq(validate(masks(3, [3, 5]), masks(3, [3, 4])), None)
  assert_eq(validate(masks(3, [3, 5]), masks(3, [3, 5])), None)
  assert_eq(validate(masks(3, [3, 5]), masks(3, [1, 2, 4])), None)
  verify_fixture(3, [1, 2, 4], [], [3, 0, 0, -1, -1], [255, 1, 0, 0])
  assert_eq(validate(masks(3, [1, 2, 4]), masks(3, [1])), None)
  assert_eq(validate(masks(3, [1, 2, 4]), masks(3, [2])), None)
  assert_eq(validate(masks(3, [1, 2, 4]), masks(3, [3])), None)
  assert_eq(validate(masks(3, [1, 2, 4]), masks(3, [4])), None)
  assert_eq(validate(masks(3, [1, 2, 4]), masks(3, [5])), None)
  assert_eq(validate(masks(3, [1, 2, 4]), masks(3, [6])), None)
  assert_eq(validate(masks(3, [1, 2, 4]), masks(3, [7])), None)
  assert_eq(validate(masks(3, [1, 2, 4]), masks(3, [1, 2])), None)
  assert_eq(validate(masks(3, [1, 2, 4]), masks(3, [1, 4])), None)
  assert_eq(validate(masks(3, [1, 2, 4]), masks(3, [1, 6])), None)
  assert_eq(validate(masks(3, [1, 2, 4]), masks(3, [2, 4])), None)
  assert_eq(validate(masks(3, [1, 2, 4]), masks(3, [2, 5])), None)
  assert_eq(validate(masks(3, [1, 2, 4]), masks(3, [3, 4])), None)
  assert_eq(validate(masks(3, [1, 2, 4]), masks(3, [3, 5])), None)
  assert_eq(validate(masks(3, [1, 2, 4]), masks(3, [1, 2, 4])), None)
}

///|
test "projective_plane edge code matches independent full vector enumeration" {
  let code = from_complex(
    complex([
      [0, 1, 2],
      [0, 2, 3],
      [0, 1, 5],
      [0, 4, 5],
      [0, 3, 4],
      [1, 2, 4],
      [1, 3, 4],
      [1, 3, 5],
      [2, 3, 5],
      [2, 4, 5],
    ]),
    @oracle.nat(1),
  ).unwrap()
  assert_eq(checks(code, X), masks(15, [31, 481, 3618, 12868, 21640, 26896]))
  assert_eq(
    checks(code, Z),
    masks(15, [35, 273, 518, 4108, 16408, 1184, 4288, 8512, 10752, 19456]),
  )
  verify_topology(code, [15, 5, 9, 1, 5, 3])
}

///|
test "torus edge code matches independent full vector enumeration" {
  let code = from_complex(
    complex([
      [0, 1, 2],
      [1, 2, 4],
      [1, 3, 4],
      [1, 3, 6],
      [0, 1, 5],
      [1, 5, 6],
      [2, 3, 5],
      [2, 4, 5],
      [2, 3, 6],
      [0, 2, 6],
      [0, 3, 4],
      [0, 3, 5],
      [4, 5, 6],
      [0, 4, 6],
    ]),
    @oracle.nat(1),
  ).unwrap()
  assert_eq(
    checks(code, X),
    masks(21, [63, 1985, 30786, 231556, 823560, 1384976, 1721376]),
  )
  assert_eq(
    checks(code, Z),
    masks(21, [
      67, 529, 16418, 32780, 65556, 524328, 4416, 33152, 132224, 1050112, 75776,
      149504, 274432, 1835008,
    ]),
  )
  verify_topology(code, [21, 6, 13, 2, 6, 3])
}
