///|
/// All three exact roots of a scaled nonzero binomial cubic. This certificate
/// authenticates the ambient real compositum and the formulas inside K(i).
/// The ambient field need not be the smallest field generated by these roots.
#derive(Debug)
pub(all) struct Certificate {
  source : @poly.Polynomial
  scale : @exact.Rational
  radicand : @exact.Rational
  cube_root : @real.RootCertificate
  common : @comp.Common
  composition : @comp.Certificate
  field : @cf.Field
  roots : @core.Chain[@cf.Element]
}

///|
pub extend Certificate with Debug::{to_repr}

///|
#derive(Debug)
pub struct Common {
  field : @cf.Field
  values : @core.Chain[@cf.Element]
  proof : Certificate
}

///|
pub extend Common with Debug::{to_repr}

///|
#derive(Debug)
enum Phase {
  Isolation(@sturm.Isolation)
  Merging(@real.Number)
}

///|
pub extend Phase with Debug::{to_repr}

///|
#derive(Debug)
pub struct Search {
  source : @poly.Polynomial
  phase : Phase
}

///|
pub extend Search with Debug::{to_repr}

///|
#derive(Eq, Debug)
pub(all) enum StopReason {
  IsolationBudget
  MergeBudget(@comp.StopReason)
}

///|
pub extend StopReason with Eq::{equal, not_equal}

///|
pub extend StopReason with Debug::{to_repr}

///|
#derive(Eq, Debug)
pub(all) enum CubicError {
  Ineligible
  SturmFailure(@sturm.BuildError)
  AlgebraFailure(@real.AlgebraError)
  MergeFailure(@comp.CompositumError)
  FieldFailure(@nf.FieldError)
  ComplexFieldFailure(@cf.FieldError)
  InternalInvariant
}

///|
pub extend CubicError with Eq::{equal, not_equal}

///|
pub extend CubicError with Debug::{to_repr}

///|
#derive(Debug)
pub(all) enum Progress {
  Ready(Common, Certificate)
  Paused(Search, StopReason)
}

///|
pub extend Progress with Debug::{to_repr}

///|
pub fn common_field(value : Common) -> @cf.Field {
  value.field
}

///|
/// Real cube root followed by the two conjugate formulas. The second root's
/// imaginary coordinate has the same sign as the real cube root.
pub fn roots(value : Common) -> @core.Chain[@cf.Element] {
  value.values
}

///|
pub fn certificate(value : Common) -> Certificate {
  value.proof
}

///|
fn source_data(
  source : @poly.Polynomial,
) -> (@exact.Rational, @exact.Rational)? {
  if !@poly.variables(source).equal(Succ(Zero)) {
    return None
  }
  match @poly.terms(source) {
    Cons(
      { coefficient: scale, exponents: Cons(Succ(Succ(Succ(Zero))), Nil), },
      Cons({ coefficient: constant, exponents: Cons(Zero, Nil), }, Nil)
    ) =>
      match @exact.rational_divide(@exact.rational_negate(constant), scale) {
        Some(radicand) =>
          if radicand.equal(@exact.rational_zero()) {
            None
          } else {
            Some((scale, radicand))
          }
        None => None
      }
    _ => None
  }
}

///|
/// Accept exactly a nonzero rational multiple of t cubed minus a nonzero
/// rational. A zero radicand must use the general repeated-factor path.
pub fn eligible(source : @poly.Polynomial) -> Bool {
  source_data(source) is Some(_)
}

///|
fn sqrt_three() -> Result[@real.Number, CubicError] {
  let one = @exact.rational_one()
  let two = @exact.rational_add(one, one)
  let three = @exact.rational_add(two, one)
  let polynomial = match
    @poly.polynomial(
      Succ(Zero),
      Cons(
        { coefficient: one, exponents: Cons(Succ(Succ(Zero)), Nil), },
        Cons(
          {
            coefficient: @exact.rational_negate(three),
            exponents: Cons(Zero, Nil),
          },
          Nil,
        ),
      ),
    ) {
    Ok(polynomial) => polynomial
    Err(_) => return Err(InternalInvariant)
  }
  match @real.number({ polynomial, interval: { lower: one, upper: two, }, }) {
    Ok(value) => Ok(value)
    Err(error) => Err(AlgebraFailure(error))
  }
}

///|
fn formula_roots(
  common : @comp.Common,
) -> Result[(@cf.Field, @core.Chain[@cf.Element]), CubicError] {
  let real_field = @comp.common_field(common)
  let field = @cf.field(real_field)
  let alpha = @comp.left_element(common)
  let beta = @comp.right_element(common)
  let half = @nf.rational(
    real_field,
    @exact.rational_half(@exact.rational_one()),
  )
  let product = match @nf.multiply(alpha, beta) {
    Ok(value) => value
    Err(error) => return Err(FieldFailure(error))
  }
  let imaginary = match @nf.multiply(product, half) {
    Ok(value) => value
    Err(error) => return Err(FieldFailure(error))
  }
  let real = match @nf.multiply(@nf.negate(alpha), half) {
    Ok(value) => value
    Err(error) => return Err(FieldFailure(error))
  }
  let a = match @cf.element(field, alpha, @nf.zero(real_field)) {
    Ok(value) => value
    Err(error) => return Err(ComplexFieldFailure(error))
  }
  let b = match @cf.element(field, real, imaginary) {
    Ok(value) => value
    Err(error) => return Err(ComplexFieldFailure(error))
  }
  let c = @cf.conjugate(b)
  Ok((field, Cons(a, Cons(b, Cons(c, Nil)))))
}

///|
fn same_roots(
  left : @core.Chain[@cf.Element],
  right : @core.Chain[@cf.Element],
) -> Bool {
  match (left, right) {
    (Nil, Nil) => true
    (Cons(a, rest), Cons(b, tail)) => @cf.equal(a, b) && same_roots(rest, tail)
    _ => false
  }
}

///|
fn actual_roots(
  source : @poly.Polynomial,
  values : @core.Chain[@cf.Element],
) -> Bool {
  fn vanishes(value : @cf.Element) -> Bool {
    match @cf.evaluate_polynomial(value, source) {
      Some(result) => @cf.is_zero(result)
      None => false
    }
  }
  match values {
    Cons(a, Cons(b, Cons(c, Nil))) =>
      !@cf.equal(a, b) &&
      !@cf.equal(a, c) &&
      !@cf.equal(b, c) &&
      vanishes(a) &&
      vanishes(b) &&
      vanishes(c)
    _ => false
  }
}
