  fraction_hitting_fixture(
    [[(1, 2), (1, 2)], [(1, 2), (1, 2)]],
    [],
    [(0, 1), (0, 1)],
    [None, None],
  )
  fraction_hitting_fixture(
    [[(1, 2), (1, 2)], [(1, 2), (1, 2)]],
    [0],
    [(1, 1), (1, 1)],
    [Some((0, 1)), Some((2, 1))],
  )
  fraction_hitting_fixture(
    [[(1, 2), (1, 2)], [(1, 2), (1, 2)]],
    [1],
    [(1, 1), (1, 1)],
    [Some((2, 1)), Some((0, 1))],
  )
  fraction_hitting_fixture(
    [[(1, 2), (1, 2)], [(1, 2), (1, 2)]],
    [0, 1],
    [(1, 1), (1, 1)],
    [Some((0, 1)), Some((0, 1))],
  )
}

