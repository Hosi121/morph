            @qf.NotZero,
          ),
        ),
      ),
    ),
  )
  review_expect(4, source, false)
}

///|
test "independent Z3 review four weighted squares zero excludes last coordinate" {
  let source = @qf.Conjunction(
    @qf.Atom(
      review_polynomial(4, [
        (1, 1, [2, 0, 0, 0]),
        (2, 1, [0, 2, 0, 0]),
        (3, 1, [0, 0, 2, 0]),
        (1, 2, [0, 0, 0, 2]),
      ]),
      @qf.EqualZero,
    ),
    @qf.Atom(review_polynomial(4, [(1, 1, [0, 0, 0, 1])]), @qf.NotZero),
  )
  review_expect(4, source, false)
}
