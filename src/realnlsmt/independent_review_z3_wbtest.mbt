      ]),
      @qf.EqualZero,
    ),
    @qf.Conjunction(
      @qf.Atom(review_polynomial(4, [(1, 1, [1, 0, 0, 0])]), @qf.EqualZero),
      @qf.Atom(review_polynomial(4, [(1, 1, [0, 0, 1, 0])]), @qf.EqualZero),
    ),
  )
  review_expect(4, source, false)
}

