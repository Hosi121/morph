    (18, [2, 1], Some([[[0, 0], [0, 1], [1, 0]], [[0], [0], [-1]], [[]], []])),
    (18, [2, 2], Some([[[0, 0], [0, 0], [1, 1]], [[0], [0], [0]], [[]], []])),
  ]
}

///|
test "independent total vertex maps from three-label complex 8" {
  let complexes = small_complexes()
  let source = generated(complexes[8])
  for fixture in small_maps_8() {
    let (target_index, images, expected) = fixture
    verify_fixture(
      source,
      generated(complexes[target_index]),
      [0, 1],
      images,
      [2, 1, 0, 0],
      expected,
    )
  }
}

