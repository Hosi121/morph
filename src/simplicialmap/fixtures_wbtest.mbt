  let complexes = small_complexes()
  let source = generated(complexes[10])
  for fixture in small_maps_10() {
    let (target_index, images, expected) = fixture
    verify_fixture(
      source,
      generated(complexes[target_index]),
      [0, 2],
      images,
      [2, 1, 0, 0],
      expected,
    )
  }
}

