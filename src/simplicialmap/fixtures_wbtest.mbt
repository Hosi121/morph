///|
test "independent total vertex maps from three-label complex 7" {
  let complexes = small_complexes()
  let source = generated(complexes[7])
  for fixture in small_maps_7() {
    let (target_index, images, expected) = fixture
    verify_fixture(
      source,
      generated(complexes[target_index]),
      [0, 1, 2],
      images,
      [3, 0, 0, 0],
      expected,
    )
  }
}

