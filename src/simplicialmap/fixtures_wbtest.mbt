///|
test "independent total vertex maps from three-label complex 15" {
  let complexes = small_complexes()
  let source = generated(complexes[15])
  for fixture in small_maps_15() {
    let (target_index, images, expected) = fixture
    verify_fixture(
      source,
      generated(complexes[target_index]),
      [0, 1, 2],
      images,
      [3, 2, 0, 0],
      expected,
    )
  }
}

