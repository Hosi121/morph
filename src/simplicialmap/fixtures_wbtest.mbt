///|
test "independent total vertex maps from three-label complex 13" {
  let complexes = small_complexes()
  let source = generated(complexes[13])
  for fixture in small_maps_13() {
    let (target_index, images, expected) = fixture
    verify_fixture(
      source,
      generated(complexes[target_index]),
      [1, 2],
      images,
      [2, 1, 0, 0],
      expected,
    )
  }
}

