///|
/// An exact multiplicative order, backed by a complete certified factorization.
#derive(Eq, Debug)
pub struct Order {
  field : @primefield.Field
  base : @binary.Binary
  factors : @factor.Factorization
}

///|
pub extend Order with Eq::{equal, not_equal}

///|
pub extend Order with Debug::{to_repr}

///|
pub fn order_value(order : Order) -> @binary.Binary {
  @factor.factorization_value(order.factors)
}

///|
pub fn order_base(order : Order) -> @binary.Binary {
  order.base
}

///|
pub fn order_field(order : Order) -> @primefield.Field {
  order.field
}

///|
pub fn order_factorization(order : Order) -> @factor.Factorization {
  order.factors
}

///|
/// Check d divides p minus one, base^d = one, and base^(d/q) is not one for
/// every prime divisor q of d. This proves the least positive order is d.
pub fn exact_order(
  field : @primefield.Field,
  base : @binary.Binary,
  factors : @factor.Factorization,
) -> Order? {
  let modulus = @primefield.modulus(field)
  let base = @modular.reduce(modulus, base)
  let order = @factor.factorization_value(factors)
  fn check_primes(
    primes : @core.Chain[@primality.Prime],
    tested : @trie.Trie[Unit],
  ) -> Bool {
    match primes {
      Nil => true
      Cons(prime, rest) => {
        let q = @primality.value(prime)
        let key = @binary.bits(q)
        match @trie.lookup(tested, key) {
          Some(_) => check_primes(rest, tested)
          None =>
            match @binary.divmod(order, q) {
              Some((exponent, remainder)) =>
                @binary.is_zero(remainder) &&
                !(@binary.compare(
                  @modular.power(modulus, base, exponent),
                  @binary.one(),
                )
                is Equal) &&
                check_primes(rest, @trie.put(tested, key, ()))
              None => false
            }
        }
      }
    }
  }
  match @binary.subtract(@modular.value(modulus), @binary.one()) {
    None => None
    Some(group_order) =>
      match @binary.divmod(group_order, order) {
        Some((_, remainder)) => {
          let valid = !@binary.is_zero(base) &&
            @binary.is_zero(remainder) &&
            @binary.compare(@modular.power(modulus, base, order), @binary.one())
            is Equal &&
            check_primes(@factor.prime_factors(factors), @trie.empty())
          match valid {
            true => Some({ field, base, factors, })
            false => None
          }
        }
        None => None
      }
  }
}

///|
/// The exact order covers the entire subgroup generated by base. Failure of a
/// complete search at this limit concerns that subgroup, not every field unit.
pub fn subgroup_problem(order : Order, target : @binary.Binary) -> Problem? {
  problem(order.field, order.base, target, order_value(order))
}
