///|
test "multi-digit bounded logarithms match committed Python enumeration" {
  let prime = @primality.check(log_prime_65537()).unwrap()
  let field = @primefield.from_prime(prime).unwrap()
  let instance = problem(
    field,
    @oracle.binary_from_hex("3"),
    @oracle.binary_from_hex("4c2e"),
    @oracle.binary_from_hex("2710"),
  ).unwrap()
  assert_eq(baby_step_giant_step(instance).map(exponent), None)
  let prime = @primality.check(log_prime_65537()).unwrap()
  let field = @primefield.from_prime(prime).unwrap()
  let instance = problem(
    field,
    @oracle.binary_from_hex("3"),
    @oracle.binary_from_hex("4c2e"),
    @oracle.binary_from_hex("2711"),
  ).unwrap()
  assert_eq(
    baby_step_giant_step(instance).map(exponent),
    Some(@oracle.binary_from_hex("2710")),
  )
  assert_eq(
    @modular.power(
      @primefield.modulus(field),
      @oracle.binary_from_hex("3"),
      @oracle.binary_from_hex("2710"),
    ),
    @oracle.binary_from_hex("4c2e"),
  )
  let prime = @primality.check(log_prime_65537()).unwrap()
  let field = @primefield.from_prime(prime).unwrap()
  let instance = problem(
    field,
    @oracle.binary_from_hex("3"),
    @oracle.binary_from_hex("4c2e"),
    @oracle.binary_from_hex("4000"),
  ).unwrap()
  assert_eq(
    baby_step_giant_step(instance).map(exponent),
    Some(@oracle.binary_from_hex("2710")),
  )
  assert_eq(
    @modular.power(
      @primefield.modulus(field),
      @oracle.binary_from_hex("3"),
      @oracle.binary_from_hex("2710"),
    ),
    @oracle.binary_from_hex("4c2e"),
  )
  let prime = @primality.check(log_prime_998244353()).unwrap()
  let field = @primefield.from_prime(prime).unwrap()
  let instance = problem(
    field,
    @oracle.binary_from_hex("3"),
    @oracle.binary_from_hex("3acedffa"),
    @oracle.binary_from_hex("10000"),
  ).unwrap()
  assert_eq(
    baby_step_giant_step(instance).map(exponent),
    Some(@oracle.binary_from_hex("c350")),
  )
  assert_eq(
    @modular.power(
      @primefield.modulus(field),
      @oracle.binary_from_hex("3"),
      @oracle.binary_from_hex("c350"),
    ),
    @oracle.binary_from_hex("3acedffa"),
  )
  let prime = @primality.check(log_prime_2305843009213693951()).unwrap()
  let field = @primefield.from_prime(prime).unwrap()
  let instance = problem(
    field,
    @oracle.binary_from_hex("25"),
    @oracle.binary_from_hex("1551069003a71acc"),
    @oracle.binary_from_hex("1000"),
  ).unwrap()
  assert_eq(
    baby_step_giant_step(instance).map(exponent),
    Some(@oracle.binary_from_hex("d80")),
  )
  assert_eq(
    @modular.power(
      @primefield.modulus(field),
      @oracle.binary_from_hex("25"),
      @oracle.binary_from_hex("d80"),
    ),
    @oracle.binary_from_hex("1551069003a71acc"),
  )
}
