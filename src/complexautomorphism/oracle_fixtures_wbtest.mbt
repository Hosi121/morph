// Generated by tools/generate_complexautomorphism_fixtures.py; independent finite oracle.

///|
test "independent split automorphism oracle: C2 over QQ(i)" {
  oracle_assert_group_fixture(
    1,
    0,
    [{ real: [(0, 1)], imaginary: [(0, 1)], }],
    [[0, 1], [1, 0]],
    0,
    1,
    [0, 1],
    [[0], [0]],
    { real: [(2, 3)], imaginary: [(-3, 5)], },
    { real: [(1, 2)], imaginary: [(-2, 3)], },
    [
      // alpha -> i^0 alpha; i -> 1 i
      {
        left: { real: [(2, 3)], imaginary: [(-3, 5)], },
        right: { real: [(1, 2)], imaginary: [(-2, 3)], },
        sum: { real: [(7, 6)], imaginary: [(-19, 15)], },
        product: { real: [(-1, 15)], imaginary: [(-67, 90)], },
      },
      // alpha -> i^0 alpha; i -> -1 i
      {
        left: { real: [(2, 3)], imaginary: [(3, 5)], },
        right: { real: [(1, 2)], imaginary: [(2, 3)], },
        sum: { real: [(7, 6)], imaginary: [(19, 15)], },
        product: { real: [(-1, 15)], imaginary: [(67, 90)], },
      },
    ],
  )
}

///|
test "independent split automorphism oracle: V4 over QQ(sqrt2)(i)" {
  oracle_assert_group_fixture(
    2,
    2,
    [
      { real: [(0, 1), (1, 1)], imaginary: [(0, 1), (0, 1)], },
      { real: [(0, 1), (-1, 1)], imaginary: [(0, 1), (0, 1)], },
    ],
    [[0, 1, 2, 3], [1, 0, 3, 2], [2, 3, 0, 1], [3, 2, 1, 0]],
    0,
    1,
    [0, 1, 2, 3],
    [[0, 1], [0, 1], [1, 0], [1, 0]],
    { real: [(2, 3), (-1, 2)], imaginary: [(-3, 5), (2, 3)], },
    { real: [(1, 2), (1, 3)], imaginary: [(-2, 3), (-1, 5)], },
    [
      // alpha -> i^0 alpha; i -> 1 i
      {
        left: { real: [(2, 3), (-1, 2)], imaginary: [(-3, 5), (2, 3)], },
        right: { real: [(1, 2), (1, 3)], imaginary: [(-2, 3), (-1, 5)], },
        sum: { real: [(7, 6), (-1, 6)], imaginary: [(-19, 15), (7, 15)], },
        product: { real: [(-2, 15), (89, 300)], imaginary: [(-1, 10), (1, 3)], },
      },
      // alpha -> i^0 alpha; i -> -1 i
      {
        left: { real: [(2, 3), (-1, 2)], imaginary: [(3, 5), (-2, 3)], },
        right: { real: [(1, 2), (1, 3)], imaginary: [(2, 3), (1, 5)], },
        sum: { real: [(7, 6), (-1, 6)], imaginary: [(19, 15), (-7, 15)], },
        product: { real: [(-2, 15), (89, 300)], imaginary: [(1, 10), (-1, 3)], },
      },
      // alpha -> i^2 alpha; i -> 1 i
      {
        left: { real: [(2, 3), (1, 2)], imaginary: [(-3, 5), (-2, 3)], },
        right: { real: [(1, 2), (-1, 3)], imaginary: [(-2, 3), (1, 5)], },
        sum: { real: [(7, 6), (1, 6)], imaginary: [(-19, 15), (-7, 15)], },
        product: {
          real: [(-2, 15), (-89, 300)],
          imaginary: [(-1, 10), (-1, 3)],
        },
      },
      // alpha -> i^2 alpha; i -> -1 i
      {
        left: { real: [(2, 3), (1, 2)], imaginary: [(3, 5), (2, 3)], },
        right: { real: [(1, 2), (-1, 3)], imaginary: [(2, 3), (-1, 5)], },
        sum: { real: [(7, 6), (1, 6)], imaginary: [(19, 15), (7, 15)], },
        product: { real: [(-2, 15), (-89, 300)], imaginary: [(1, 10), (1, 3)], },
      },
    ],
  )
}

