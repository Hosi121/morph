///|
test "independent split automorphism oracle: D4 with permuted root order" {
  oracle_assert_group_fixture(
    4,
    2,
    [
      {
        real: [(0, 1), (0, 1), (0, 1), (0, 1)],
        imaginary: [(0, 1), (1, 1), (0, 1), (0, 1)],
