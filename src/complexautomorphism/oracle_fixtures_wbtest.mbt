        imaginary: [(0, 1), (0, 1), (0, 1), (0, 1)],
      },
    ],
    [
      [2, 3, 4, 5, 6, 7, 0, 1],
      [7, 6, 5, 4, 3, 2, 1, 0],
      [4, 5, 6, 7, 0, 1, 2, 3],
      [1, 0, 7, 6, 5, 4, 3, 2],
      [6, 7, 0, 1, 2, 3, 4, 5],
      [3, 2, 1, 0, 7, 6, 5, 4],
      [0, 1, 2, 3, 4, 5, 6, 7],
      [5, 4, 3, 2, 1, 0, 7, 6],
