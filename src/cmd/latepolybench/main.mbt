        (-1, 1, [3, 0]),
        (0, 1, [5, 0]),
        (1, 1, [7, 0]),
        (2, 1, [9, 0]),
        (-2, 1, [11, 0]),
        (-1, 1, [13, 0]),
        (0, 1, [15, 0]),
        (1, 1, [17, 0]),
        (2, 1, [19, 0]),
