        (3, 1, [37, 0]),
        (2, 1, [36, 0]),
        (1, 1, [35, 0]),
        (3, 1, [34, 0]),
        (2, 1, [33, 0]),
        (1, 1, [32, 0]),
        (-3, 1, [23, 0]),
        (-2, 1, [22, 0]),
        (-1, 1, [21, 0]),
        (-3, 1, [20, 0]),
        (-2, 1, [19, 0]),
        (-1, 1, [18, 0]),
        (-3, 1, [17, 0]),
        (-2, 1, [16, 0]),
        (-1, 1, [15, 0]),
        (-3, 1, [14, 0]),
        (-2, 1, [13, 0]),
        (-1, 1, [12, 0]),
        (-3, 1, [11, 0]),
        (-2, 1, [10, 0]),
        (-1, 1, [9, 0]),
        (-3, 1, [8, 0]),
        (-2, 1, [7, 0]),
        (-1, 1, [6, 0]),
        (-3, 1, [5, 0]),
        (-2, 1, [4, 0]),
        (-1, 1, [3, 0]),
        (-3, 1, [2, 0]),
        (-2, 1, [1, 0]),
        (-1, 1, [0, 0]),
      ])
      if @poly.add(a, @poly.negate(b)) != Ok(expected) {
        abort("old composed subtraction oracle mismatch")
      }
      (
        12000,
        fn() {
          let result = @poly.subtract(a, b).unwrap()
          if result != expected {
            abort("full Fraction difference mismatch")
          }
          polynomial_json(result)
        },
      )
    }
    "mixed-rational" => {
      let a = polynomial(3, [
        (-3, 2, [0, 0, 0]),
        (-2, 3, [1, 1, 0]),
        (-1, 4, [2, 2, 0]),
        (0, 5, [3, 0, 0]),
        (1, 2, [4, 1, 0]),
        (2, 3, [5, 2, 0]),
        (3, 4, [6, 0, 0]),
        (-3, 5, [7, 1, 0]),
        (-2, 2, [8, 2, 0]),
