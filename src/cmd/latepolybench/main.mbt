        (-2, 5, [15, 0, 0]),
        (-1, 2, [16, 1, 0]),
        (0, 3, [17, 2, 0]),
        (1, 4, [18, 0, 0]),
        (2, 5, [19, 1, 0]),
        (3, 2, [20, 2, 0]),
        (-3, 3, [21, 0, 0]),
        (-2, 4, [22, 1, 0]),
        (-1, 5, [23, 2, 0]),
        (0, 2, [24, 0, 0]),
