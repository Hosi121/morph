        (-1, 2, [1, 0]),
        (0, 3, [2, 0]),
        (1, 1, [3, 0]),
        (2, 2, [4, 0]),
        (-2, 3, [5, 0]),
        (-1, 1, [6, 0]),
        (0, 2, [7, 0]),
        (1, 3, [8, 0]),
