        (1, 1, [36, 0]),
        (3, 1, [34, 0]),
        (1, 1, [33, 0]),
        (2, 1, [32, 0]),
        (2, 1, [31, 0]),
        (1, 1, [30, 0]),
        (-2, 1, [29, 0]),
        (3, 1, [28, 0]),
        (-1, 1, [27, 0]),
        (2, 1, [26, 0]),
        (1, 1, [24, 0]),
        (1, 1, [23, 0]),
        (3, 1, [22, 0]),
        (2, 1, [21, 0]),
        (2, 1, [20, 0]),
        (-2, 1, [19, 0]),
        (1, 1, [18, 0]),
        (-1, 1, [17, 0]),
        (3, 1, [16, 0]),
        (2, 1, [14, 0]),
        (1, 1, [13, 0]),
        (1, 1, [12, 0]),
        (2, 1, [11, 0]),
        (3, 1, [10, 0]),
        (-2, 1, [9, 0]),
        (2, 1, [8, 0]),
        (-1, 1, [7, 0]),
        (1, 1, [6, 0]),
        (3, 1, [4, 0]),
        (1, 1, [3, 0]),
        (2, 1, [2, 0]),
        (2, 1, [1, 0]),
        (1, 1, [0, 0]),
      ])
      if @poly.add(a, @poly.negate(b)) != Ok(expected) {
