        (0, 3, [2, 0]),
        (1, 1, [3, 0]),
        (2, 2, [4, 0]),
        (-2, 3, [5, 0]),
        (-1, 1, [6, 0]),
        (0, 2, [7, 0]),
        (1, 3, [8, 0]),
        (2, 1, [9, 0]),
        (-2, 2, [10, 0]),
        (-1, 3, [11, 0]),
        (0, 1, [12, 0]),
        (1, 2, [13, 0]),
        (2, 3, [14, 0]),
        (-2, 1, [15, 0]),
        (-1, 2, [16, 0]),
        (0, 3, [17, 0]),
        (1, 1, [18, 0]),
        (2, 2, [19, 0]),
        (-2, 3, [20, 0]),
