    "block-disjoint" => {
      let a = polynomial(2, [
        (1, 1, [32, 0]),
        (2, 1, [33, 0]),
        (3, 1, [34, 0]),
        (1, 1, [35, 0]),
        (2, 1, [36, 0]),
        (3, 1, [37, 0]),
        (1, 1, [38, 0]),
        (2, 1, [39, 0]),
        (3, 1, [40, 0]),
        (1, 1, [41, 0]),
        (2, 1, [42, 0]),
        (3, 1, [43, 0]),
        (1, 1, [44, 0]),
        (2, 1, [45, 0]),
        (3, 1, [46, 0]),
        (1, 1, [47, 0]),
        (2, 1, [48, 0]),
        (3, 1, [49, 0]),
        (1, 1, [50, 0]),
        (2, 1, [51, 0]),
        (3, 1, [52, 0]),
        (1, 1, [53, 0]),
        (2, 1, [54, 0]),
        (3, 1, [55, 0]),
      ])
      let b = polynomial(2, [
        (1, 1, [0, 0]),
        (2, 1, [1, 0]),
        (3, 1, [2, 0]),
        (1, 1, [3, 0]),
        (2, 1, [4, 0]),
        (3, 1, [5, 0]),
        (1, 1, [6, 0]),
        (2, 1, [7, 0]),
        (3, 1, [8, 0]),
        (1, 1, [9, 0]),
        (2, 1, [10, 0]),
        (3, 1, [11, 0]),
        (1, 1, [12, 0]),
        (2, 1, [13, 0]),
        (3, 1, [14, 0]),
        (1, 1, [15, 0]),
        (2, 1, [16, 0]),
        (3, 1, [17, 0]),
        (1, 1, [18, 0]),
        (2, 1, [19, 0]),
        (3, 1, [20, 0]),
        (1, 1, [21, 0]),
        (2, 1, [22, 0]),
        (3, 1, [23, 0]),
      ])
      let expected = polynomial(2, [
        (3, 1, [55, 0]),
        (2, 1, [54, 0]),
        (1, 1, [53, 0]),
        (3, 1, [52, 0]),
        (2, 1, [51, 0]),
        (1, 1, [50, 0]),
        (3, 1, [49, 0]),
        (2, 1, [48, 0]),
        (1, 1, [47, 0]),
        (3, 1, [46, 0]),
        (2, 1, [45, 0]),
