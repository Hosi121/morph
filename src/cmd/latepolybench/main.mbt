        (1, 1, [54, 0]),
        (3, 1, [52, 0]),
        (2, 1, [50, 0]),
        (1, 1, [48, 0]),
        (-1, 1, [47, 0]),
        (3, 1, [46, 0]),
        (2, 1, [44, 0]),
        (1, 1, [43, 0]),
        (1, 1, [42, 0]),
        (2, 1, [41, 0]),
        (3, 1, [40, 0]),
        (-2, 1, [39, 0]),
        (2, 1, [38, 0]),
