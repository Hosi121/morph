        (1, 5, [8, 2, 0]),
        (2, 3, [9, 1, 0]),
        (-2, 4, [10, 1, 0]),
        (-1, 5, [11, 0, 0]),
        (0, 3, [12, 0, 0]),
        (1, 4, [13, 2, 0]),
        (2, 5, [14, 2, 0]),
        (-2, 3, [15, 1, 0]),
        (-1, 4, [16, 1, 0]),
        (0, 5, [17, 0, 0]),
        (1, 3, [18, 0, 0]),
        (2, 4, [19, 2, 0]),
        (-2, 5, [20, 2, 0]),
        (-1, 3, [21, 1, 0]),
        (0, 4, [22, 1, 0]),
        (1, 5, [23, 0, 0]),
        (2, 3, [24, 0, 0]),
        (-2, 4, [25, 2, 0]),
        (-1, 5, [26, 2, 0]),
        (0, 3, [27, 1, 0]),
        (1, 4, [28, 1, 0]),
        (2, 5, [29, 0, 0]),
        (-2, 3, [30, 0, 0]),
        (-1, 4, [31, 2, 0]),
      ])
      let expected = polynomial(3, [
        (1, 4, [31, 2, 0]),
        (5, 12, [30, 0, 0]),
        (-2, 3, [29, 2, 0]),
        (-2, 5, [29, 0, 0]),
        (-7, 4, [28, 1, 0]),
        (3, 5, [27, 0, 0]),
        (7, 10, [26, 2, 0]),
        (1, 2, [25, 2, 0]),
        (1, 3, [25, 1, 0]),
        (-2, 3, [24, 0, 0]),
        (-1, 5, [23, 2, 0]),
        (-1, 5, [23, 0, 0]),
        (-1, 2, [22, 1, 0]),
        (1, 3, [21, 1, 0]),
        (-1, 1, [21, 0, 0]),
        (19, 10, [20, 2, 0]),
        (-1, 2, [19, 2, 0]),
        (2, 5, [19, 1, 0]),
        (-1, 12, [18, 0, 0]),
        (-1, 4, [16, 1, 0]),
        (2, 3, [15, 1, 0]),
        (-2, 5, [15, 0, 0]),
        (-23, 20, [14, 2, 0]),
        (-1, 4, [13, 2, 0]),
        (1, 1, [13, 1, 0]),
        (1, 1, [12, 0, 0]),
        (1, 5, [11, 2, 0]),
        (1, 5, [11, 0, 0]),
        (1, 2, [10, 1, 0]),
        (-2, 3, [9, 1, 0]),
        (-1, 3, [9, 0, 0]),
        (-6, 5, [8, 2, 0]),
        (-3, 5, [7, 1, 0]),
        (13, 12, [6, 0, 0]),
        (2, 3, [5, 2, 0]),
        (2, 5, [5, 0, 0]),
        (-1, 3, [3, 1, 0]),
        (-1, 4, [2, 2, 0]),
        (1, 4, [1, 2, 0]),
        (-2, 3, [1, 1, 0]),
        (-5, 6, [0, 0, 0]),
      ])
      if @poly.add(a, @poly.negate(b)) != Ok(expected) {
        abort("old composed subtraction oracle mismatch")
      }
      (
        12000,
        fn() {
          let result = @poly.subtract(a, b).unwrap()
          if result != expected {
            abort("full Fraction difference mismatch")
          }
          polynomial_json(result)
        },
      )
    }
    "small-zero-errors" => {
      let zero = @poly.zero(@oracle.nat(2))
      let a = polynomial(2, [(1, 3, [1, 0]), (-2, 5, [0, 0])])
      let expected = polynomial(2, [(-1, 3, [1, 0]), (2, 5, [0, 0])])
      let constant = polynomial(0, [(1, 3, [])])
      let other = polynomial(0, [(-2, 5, [])])
      let wanted = polynomial(0, [(11, 15, [])])
      (
        100000,
        fn() {
          if @poly.subtract(zero, a) != Ok(expected) ||
            @poly.subtract(a, zero) != Ok(a) ||
            @poly.subtract(a, a) != Ok(zero) ||
            @poly.subtract(constant, other) != Ok(wanted) ||
            @poly.subtract(zero, @poly.zero(@oracle.nat(1))) !=
            Err(@poly.DimensionMismatch) {
            abort("small/zero/constant/dimension result mismatch")
          }
          polynomial_json(wanted)
        },
      )
    }
    "buchberger" => {
      let gs = @oracle.chain([
        polynomial(2, [(1, 1, [2, 0]), (-1, 1, [0, 1])]),
        polynomial(2, [(1, 1, [1, 1]), (-1, 1, [0, 0])]),
      ])
      let expected = @oracle.chain([
        polynomial(2, [(1, 1, [1, 0]), (-1, 1, [0, 2])]),
        polynomial(2, [(1, 1, [0, 3]), (-1, 1, [0, 0])]),
      ])
      (
        10000,
        fn() {
          let b = match
            @gb.buchberger(@oracle.nat(2), gs, @oracle.nat(1000)).unwrap() {
            Complete(b) => b
            _ => abort("upper producer incomplete")
          }
          if @gb.polynomials(b) != expected || @gb.verify(b) != Ok(true) {
            abort("full SymPy basis or public verifier differs")
          }
          "[" +
          @oracle.array(@gb.polynomials(b)).map(polynomial_json).join(",") +
          "]"
        },
      )
    }
    _ => abort("unknown subtraction case")
  }
  let expected = operation()
  let started = @bench.monotonic_clock_start()
  for _ in 0..<iterations {
    if operation() != expected {
      abort("unstable full output")
    }
  }
  let elapsed_us = @bench.monotonic_clock_end(started)
  println(
    "{\"case\":\"\{name}\",\"iterations\":\{iterations},\"result\":\{expected},\"elapsed_us\":\{elapsed_us},\"checked\":true}",
  )
}
