///|
/// Frozen public API comparison; expectations generated by Python integers.
fn binary_json(value : @binary.Binary) -> String {
  "\"" + @oracle.hex_bits(@binary.bits(value)) + "\""
}

///|
fn vector_json(values : Array[@binary.Binary]) -> String {
  "[" + values.map(binary_json).join(",") + "]"
}

///|
fn option_json(values : Array[@binary.Binary?]) -> String {
  "[" +
  values
  .map(fn(value) {
    match value {
      None => "null"
      Some(value) => binary_json(value)
    }
  })
  .join(",") +
  "]"
}

///|
fn main {
  let args = @env.args()
  let name = args[args.length() - 1]
  let (iterations, operation) : (Int32, () -> String) = match name {
    "negative-reduced" => {
      let ring = @modular.modulus(@oracle.binary_from_hex("10001")).unwrap()
      let inputs = [
        @oracle.binary_from_hex("1"),
        @oracle.binary_from_hex("2"),
        @oracle.binary_from_hex("3"),
        @oracle.binary_from_hex("11"),
        @oracle.binary_from_hex("8000"),
        @oracle.binary_from_hex("10000"),
      ].map(fn(value) {
        let integer = @exact.positive(value)
        @exact.negate(integer)
      })
      let wanted = [
        @oracle.binary_from_hex("10000"),
        @oracle.binary_from_hex("ffff"),
        @oracle.binary_from_hex("fffe"),
        @oracle.binary_from_hex("fff0"),
        @oracle.binary_from_hex("8001"),
        @oracle.binary_from_hex("1"),
      ]
      (
        8000,
        fn() {
          let actual = inputs.map(fn(value) {
            @modular.signed_reduce(ring, value)
          })
          if actual != wanted {
            abort("Python full signed residue mismatch")
          }
          vector_json(actual)
        },
      )
    }
    "negative-unreduced" => {
      let ring = @modular.modulus(@oracle.binary_from_hex("10001")).unwrap()
      let inputs = [
        @oracle.binary_from_hex("10001"),
        @oracle.binary_from_hex("10002"),
        @oracle.binary_from_hex("20001"),
        @oracle.binary_from_hex("f4240"),
        @oracle.binary_from_hex(
          "f123456789abcdeff123456789abcdeff123456789abcdeff123456789abcdef",
        ),
        @oracle.binary_from_hex(
          "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff",
        ),
      ].map(fn(value) {
        let integer = @exact.positive(value)
        @exact.negate(integer)
      })
      let wanted = [
        @oracle.binary_from_hex("0"),
        @oracle.binary_from_hex("10000"),
        @oracle.binary_from_hex("1"),
        @oracle.binary_from_hex("bdd0"),
        @oracle.binary_from_hex("9ddf"),
        @oracle.binary_from_hex("0"),
      ]
      (
        600,
        fn() {
          let actual = inputs.map(fn(value) {
            @modular.signed_reduce(ring, value)
          })
          if actual != wanted {
            abort("Python full signed residue mismatch")
          }
          vector_json(actual)
        },
      )
    }
    "positive-control" => {
      let ring = @modular.modulus(@oracle.binary_from_hex("10001")).unwrap()
      let inputs = [
        @oracle.binary_from_hex("0"),
        @oracle.binary_from_hex("1"),
        @oracle.binary_from_hex("2"),
        @oracle.binary_from_hex("3"),
        @oracle.binary_from_hex("11"),
        @oracle.binary_from_hex("8000"),
        @oracle.binary_from_hex("10000"),
      ].map(fn(value) {
        let integer = @exact.positive(value)
        integer
      })
      let wanted = [
        @oracle.binary_from_hex("0"),
        @oracle.binary_from_hex("1"),
        @oracle.binary_from_hex("2"),
        @oracle.binary_from_hex("3"),
        @oracle.binary_from_hex("11"),
        @oracle.binary_from_hex("8000"),
        @oracle.binary_from_hex("10000"),
      ]
      (
        8000,
        fn() {
          let actual = inputs.map(fn(value) {
            @modular.signed_reduce(ring, value)
          })
          if actual != wanted {
            abort("Python full signed residue mismatch")
          }
          vector_json(actual)
        },
      )
    }
    "one-shot" => {
      let ring = @modular.modulus(
        @oracle.binary_from_hex(
          "7fffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffed",
        ),
      ).unwrap()
      let inputs = [
        @oracle.binary_from_hex(
          "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff",
        ),
      ].map(fn(value) {
        let integer = @exact.positive(value)
        @exact.negate(integer)
      })
      let wanted = [
        @oracle.binary_from_hex(
          "7fffffffffffffffffffffffffffffffffffffffffffffffffffffffffe02ede",
        ),
      ]
      (
        1,
        fn() {
          let actual = inputs.map(fn(value) {
            @modular.signed_reduce(ring, value)
          })
          if actual != wanted {
            abort("Python full signed residue mismatch")
          }
          vector_json(actual)
        },
      )
    }
    "zero-tiny-boundaries" => {
      let ring0 = @modular.modulus(@oracle.binary_from_hex("2")).unwrap()
      let inputs0 = [
        @oracle.integer(0),
        @oracle.integer(-1),
        @oracle.integer(-2),
        @oracle.integer(-3),
        @oracle.integer(1),
        @oracle.integer(2),
      ]
      let wanted0 = [
        @oracle.binary_from_hex("0"),
        @oracle.binary_from_hex("1"),
        @oracle.binary_from_hex("0"),
        @oracle.binary_from_hex("1"),
        @oracle.binary_from_hex("1"),
        @oracle.binary_from_hex("0"),
      ]
      let ring1 = @modular.modulus(@oracle.binary_from_hex("11")).unwrap()
      let inputs1 = [
        @oracle.integer(0),
        @oracle.integer(-17),
        @oracle.integer(-34),
        @oracle.integer(-1),
        @oracle.integer(-16),
        @oracle.integer(17),
      ]
      let wanted1 = [
        @oracle.binary_from_hex("0"),
        @oracle.binary_from_hex("0"),
        @oracle.binary_from_hex("0"),
        @oracle.binary_from_hex("10"),
        @oracle.binary_from_hex("1"),
        @oracle.binary_from_hex("0"),
      ]
      let ring2 = @modular.modulus(@oracle.binary_from_hex("10001")).unwrap()
      let inputs2 = [
        @oracle.integer(0),
        @oracle.integer(-65537),
        @oracle.integer(-131074),
        @oracle.integer(65537),
      ]
      let wanted2 = [
        @oracle.binary_from_hex("0"),
        @oracle.binary_from_hex("0"),
        @oracle.binary_from_hex("0"),
        @oracle.binary_from_hex("0"),
      ]
      (
        5000,
        fn() {
          if @modular.modulus(@binary.zero()) != None ||
            @modular.modulus(@binary.one()) != None {
            abort("invalid public modulus accepted")
          }
          let actual0 = inputs0.map(fn(value) {
            @modular.signed_reduce(ring0, value)
          })
          if actual0 != wanted0 {
            abort("Python zero/tiny/multiple mismatch")
          }
          let actual1 = inputs1.map(fn(value) {
            @modular.signed_reduce(ring1, value)
          })
          if actual1 != wanted1 {
            abort("Python zero/tiny/multiple mismatch")
          }
          let actual2 = inputs2.map(fn(value) {
            @modular.signed_reduce(ring2, value)
          })
          if actual2 != wanted2 {
            abort("Python zero/tiny/multiple mismatch")
          }
          "[" +
          vector_json(actual0) +
          "," +
          vector_json(actual1) +
          "," +
          vector_json(actual2) +
          "]"
        },
      )
    }
    "inverse-field" => {
      let ring = @modular.modulus(@oracle.binary_from_hex("10001")).unwrap()
      let field = @primefield.field(@oracle.binary_from_hex("10001")).unwrap()
      let ops = @primefield.arithmetic(field)
      let inputs = [
        @oracle.binary_from_hex("0"),
        @oracle.binary_from_hex("1"),
        @oracle.binary_from_hex("2"),
        @oracle.binary_from_hex("3"),
        @oracle.binary_from_hex("11"),
        @oracle.binary_from_hex("8000"),
        @oracle.binary_from_hex("10000"),
        @oracle.binary_from_hex("10001"),
        @oracle.binary_from_hex("10003"),
        @oracle.binary_from_hex("f4240"),
      ]
      let wanted = [
        None,
        Some(@oracle.binary_from_hex("1")),
        Some(@oracle.binary_from_hex("8001")),
        Some(@oracle.binary_from_hex("5556")),
        Some(@oracle.binary_from_hex("7879")),
        Some(@oracle.binary_from_hex("ffff")),
        Some(@oracle.binary_from_hex("10000")),
        None,
        Some(@oracle.binary_from_hex("8001")),
        Some(@oracle.binary_from_hex("86cb")),
      ]
      let composite = @modular.modulus(@oracle.binary_from_hex("ffff")).unwrap()
      let composite_inputs = [
        @oracle.binary_from_hex("0"),
        @oracle.binary_from_hex("1"),
        @oracle.binary_from_hex("2"),
        @oracle.binary_from_hex("3"),
        @oracle.binary_from_hex("5"),
        @oracle.binary_from_hex("9"),
        @oracle.binary_from_hex("11"),
        @oracle.binary_from_hex("ffff"),
        @oracle.binary_from_hex("10001"),
      ]
      let composite_wanted = [
        None,
        Some(@oracle.binary_from_hex("1")),
        Some(@oracle.binary_from_hex("8000")),
        None,
        None,
        None,
        None,
        None,
        Some(@oracle.binary_from_hex("8000")),
      ]
      (
        300,
        fn() {
          let actual = inputs.map(fn(value) { @modular.inverse(ring, value) })
          let through_field = inputs.map(fn(value) { (ops.inverse)(value) })
          let composite_actual = composite_inputs.map(fn(value) {
            @modular.inverse(composite, value)
          })
          if actual != wanted ||
            through_field != wanted ||
            composite_actual != composite_wanted {
            abort("Python full inverse/None mismatch")
          }
          "[" +
          option_json(actual) +
          "," +
          option_json(through_field) +
          "," +
          option_json(composite_actual) +
          "]"
        },
      )
    }
    _ => abort("unknown signed reduction case")
  }
  let expected = operation()
  let started = @bench.monotonic_clock_start()
  for _ in 0..<iterations {
    if operation() != expected {
      abort("unstable full canonical output")
    }
  }
  let elapsed_us = @bench.monotonic_clock_end(started)
  println(
    "{\"case\":\"\{name}\",\"iterations\":\{iterations},\"result\":\{expected},\"elapsed_us\":\{elapsed_us},\"checked\":true}",
  )
}
