        (-1, 1, [28, 3]),
        (1, 1, [28, 0]),
        (1, 1, [24, 3]),
        (-1, 1, [24, 0]),
        (-1, 1, [22, 3]),
        (1, 1, [22, 0]),
        (1, 1, [18, 3]),
        (-1, 1, [18, 0]),
        (-1, 1, [16, 3]),
        (1, 1, [16, 0]),
        (1, 1, [12, 3]),
        (-1, 1, [12, 0]),
        (-1, 1, [10, 3]),
        (1, 1, [10, 0]),
        (1, 1, [6, 3]),
        (-1, 1, [6, 0]),
        (-1, 1, [4, 3]),
        (1, 1, [4, 0]),
        (1, 1, [0, 3]),
        (-1, 1, [0, 0]),
      ])
      (
        1500,
        fn() {
          let result = @poly.multiply(a, b).unwrap()
          if result != expected {
            abort("full Fraction convolution mismatch")
          }
          polynomial_json(result)
        },
      )
    }
    "rational-cancellation" => {
      let a = polynomial(1, [
        (1, 2, [0]),
        (-1, 3, [1]),
        (1, 4, [2]),
        (-1, 5, [3]),
        (1, 2, [4]),
        (-1, 3, [5]),
        (1, 4, [6]),
        (-1, 5, [7]),
        (1, 2, [8]),
        (-1, 3, [9]),
        (1, 4, [10]),
        (-1, 5, [11]),
        (1, 2, [12]),
        (-1, 3, [13]),
        (1, 4, [14]),
        (-1, 5, [15]),
        (1, 2, [16]),
        (-1, 3, [17]),
        (1, 4, [18]),
        (-1, 5, [19]),
      ])
      let b = polynomial(1, [
        (1, 2, [0]),
        (1, 3, [1]),
        (1, 4, [2]),
        (1, 5, [3]),
        (1, 2, [4]),
        (1, 3, [5]),
        (1, 4, [6]),
        (1, 5, [7]),
        (1, 2, [8]),
        (1, 3, [9]),
        (1, 4, [10]),
        (1, 5, [11]),
        (1, 2, [12]),
        (1, 3, [13]),
        (1, 4, [14]),
        (1, 5, [15]),
        (1, 2, [16]),
        (1, 3, [17]),
        (1, 4, [18]),
        (1, 5, [19]),
      ])
      let expected = polynomial(1, [
        (-1, 25, [38]),
        (-17, 240, [36]),
        (53, 900, [34]),
        (13, 120, [32]),
        (71, 450, [30]),
        (23, 80, [28]),
        (77, 300, [26]),
        (7, 15, [24]),
        (16, 45, [22]),
        (31, 48, [20]),
        (481, 900, [18]),
        (29, 30, [16]),
        (98, 225, [14]),
        (63, 80, [12]),
        (101, 300, [10]),
        (73, 120, [8]),
        (107, 450, [6]),
        (103, 240, [4]),
        (5, 36, [2]),
        (1, 4, [0]),
      ])
      (
        800,
        fn() {
          let result = @poly.multiply(a, b).unwrap()
          if result != expected {
            abort("full Fraction convolution mismatch")
          }
          polynomial_json(result)
        },
      )
    }
    "small-controls" => {
      let z = @poly.zero(@oracle.nat(2))
      let a = polynomial(2, [(1, 2, [1, 0])])
      let b = polynomial(2, [(1, 3, [0, 1]), (-1, 3, [0, 0])])
      let expected = polynomial(2, [(1, 6, [1, 1]), (-1, 6, [1, 0])])
      (
        100000,
        fn() {
          if @poly.multiply(z, b) != Ok(z) ||
            @poly.multiply(b, z) != Ok(z) ||
            @poly.multiply(a, b) != Ok(expected) ||
            @poly.multiply(z, @poly.zero(@oracle.nat(1))) !=
            Err(@poly.DimensionMismatch) {
            abort("small or empty product mismatch")
          }
          let square = @poly.multiply(b, b).unwrap()
          if square !=
            polynomial(2, [(1, 9, [0, 2]), (-2, 9, [0, 1]), (1, 9, [0, 0])]) {
            abort("tiny cancellation mismatch")
          }
          polynomial_json(square)
        },
      )
    }
    "buchberger" => {
      let gs = @oracle.chain([
        polynomial(2, [(1, 1, [2, 0]), (-1, 1, [0, 1])]),
        polynomial(2, [(1, 1, [1, 1]), (-1, 1, [0, 0])]),
      ])
      let expected = @oracle.chain([
        polynomial(2, [(1, 1, [1, 0]), (-1, 1, [0, 2])]),
        polynomial(2, [(1, 1, [0, 3]), (-1, 1, [0, 0])]),
      ])
      (
        8000,
        fn() {
          let b = match
            @gb.buchberger(@oracle.nat(2), gs, @oracle.nat(1000)).unwrap() {
            Complete(b) => b
            _ => abort("incomplete upper producer")
          }
          if @gb.polynomials(b) != expected || @gb.verify(b) != Ok(true) {
            abort("full SymPy basis or verifier differs")
          }
          "[" +
          @oracle.array(@gb.polynomials(b)).map(polynomial_json).join(",") +
          "]"
        },
      )
    }
    _ => abort("unknown product case")
  }
  let expected = operation()
  let started = @bench.monotonic_clock_start()
  for _ in 0..<iterations {
    if operation() != expected {
      abort("unstable full output")
    }
  }
  let elapsed_us = @bench.monotonic_clock_end(started)
  println(
    "{\"case\":\"\{name}\",\"iterations\":\{iterations},\"result\":\{expected},\"elapsed_us\":\{elapsed_us},\"checked\":true}",
  )
}
