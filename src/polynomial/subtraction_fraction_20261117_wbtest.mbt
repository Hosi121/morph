// Generated by docs/research/late-subtraction-20261117-oracle.py (independent Python Fraction).

///|
fn subtraction_fixture(
  n : Int32,
  data : Array[(Int32, Int32, Array[Int32])],
) -> Polynomial {
  polynomial(
    @oracle.nat(n),
    @oracle.chain(
      data.map(fn(t) {
        Term::{
          coefficient: @oracle.rational(t.0, t.1),
          exponents: @oracle.chain(t.2.map(@oracle.nat)),
        }
      }),
    ),
  ).unwrap()
}

///|
fn old_composed_subtraction(
  a : Polynomial,
  b : Polynomial,
) -> Result[Polynomial, PolyError] {
  add(a, negate(b))
}

///|
test "Fraction full polynomial subtraction fixture 0" {
  let a = subtraction_fixture(0, [])

  let b = subtraction_fixture(0, [(-2, 1, [])])

  let expected = subtraction_fixture(0, [(2, 1, [])])

  assert_eq(subtract(a, b), Ok(expected))

  assert_eq(subtract(a, b), old_composed_subtraction(a, b))

  assert_eq(subtract(b, a), Ok(negate(expected)))

  assert_eq(subtract(a, a), Ok(zero(@oracle.nat(0))))
}

