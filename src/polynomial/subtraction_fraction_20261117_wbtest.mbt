  let a = subtraction_fixture(2, [(1, 3, [1, 0])])

  let b = subtraction_fixture(2, [(1, 3, [1, 0])])

  let expected = subtraction_fixture(2, [])

  assert_eq(subtract(a, b), Ok(expected))

  assert_eq(subtract(a, b), old_composed_subtraction(a, b))

  assert_eq(subtract(b, a), Ok(negate(expected)))

  assert_eq(subtract(a, a), Ok(zero(@oracle.nat(2))))
}

///|
test "Fraction full polynomial subtraction fixture 29" {
  let a = subtraction_fixture(1, [])

  let b = subtraction_fixture(1, [(-2, 3, [4]), (1, 2, [0])])

  let expected = subtraction_fixture(1, [(2, 3, [4]), (-1, 2, [0])])

  assert_eq(subtract(a, b), Ok(expected))

  assert_eq(subtract(a, b), old_composed_subtraction(a, b))

  assert_eq(subtract(b, a), Ok(negate(expected)))

  assert_eq(subtract(a, a), Ok(zero(@oracle.nat(1))))
}

///|
test "Fraction full polynomial subtraction fixture 30" {
  let a = subtraction_fixture(0, [(1, 3, [])])

  let b = subtraction_fixture(0, [(-2, 5, [])])

  let expected = subtraction_fixture(0, [(11, 15, [])])

  assert_eq(subtract(a, b), Ok(expected))

  assert_eq(subtract(a, b), old_composed_subtraction(a, b))

  assert_eq(subtract(b, a), Ok(negate(expected)))

  assert_eq(subtract(a, a), Ok(zero(@oracle.nat(0))))
}

///|
test "subtraction zero operands retain dimension errors" {
  let a = zero(Zero)

  let b = zero(@oracle.nat(2))

  assert_eq(subtract(a, b), Err(DimensionMismatch))

  assert_eq(subtract(b, a), Err(DimensionMismatch))

  assert_eq(subtract(a, b), old_composed_subtraction(a, b))
}
