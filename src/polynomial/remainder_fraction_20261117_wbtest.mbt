// Generated by docs/research/night-normal-form-20261117-oracle.py (Python Fraction).

///|
fn remainder_fixture(
  n : Int32,
  data : Array[(Int32, Int32, Array[Int32])],
) -> Polynomial {
  polynomial(
    @oracle.nat(n),
    @oracle.chain(
      data.map(fn(t) {
        Term::{
          coefficient: @oracle.rational(t.0, t.1),
          exponents: @oracle.chain(t.2.map(@oracle.nat)),
        }
      }),
    ),
  ).unwrap()
}

///|
test "Fraction lex remainder independent fixture 0" {
  let p = remainder_fixture(1, [
    (-2, 1, [0]),
    (-1, 2, [1]),
    (0, 1, [2]),
    (1, 2, [0]),
    (2, 1, [1]),
    (-2, 2, [2]),
    (-1, 1, [0]),
  ])

  let divisors = @oracle.chain([
    remainder_fixture(1, [(2, 1, [2]), (-1, 1, [0])]),
  ])

  let expected = remainder_fixture(1, [(3, 2, [1]), (-3, 1, [0])])

  assert_eq(normal_form(p, divisors), Ok(expected))

  assert_eq(divide(p, divisors).unwrap().remainder, expected)
}

