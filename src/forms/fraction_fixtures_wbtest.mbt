          (1, 15, [1, 0, 0, 0]),
        ],
        [2, 3],
      ),
    ]),
    [
      (
        [(4, 3, [1, 2, 1, 0]), (-1, 2, [1, 2, 0, 0]), (-2, 1, [1, 0, 1, 0])],
        [0, 1, 2],
      ),
      ([(3, 5, [1, 0, 2, 0])], [0, 1, 3]),
      (
        [
          (6, 1, [2, 0, 1, 1]),
          (6, 5, [1, 1, 1, 0]),
          (-1, 5, [0, 2, 0, 2]),
          (1, 5, [0, 0, 0, 0]),
        ],
        [0, 2, 3],
      ),
      ([(-2, 5, [1, 1, 0, 2])], [1, 2, 3]),
    ],
    true,
  )
}

///|
test "Fraction integrated radial homotopy and primitive 86" {
  fraction_homotopy_fixture(
    4,
    3,
    [
      ([(-4, 1, [1, 2, 0, 1])], [0, 1, 2]),
      (
        [(-2, 1, [2, 2, 0, 0]), (3, 2, [0, 1, 2, 0]), (2, 3, [0, 0, 1, 1])],
        [1, 2, 3],
      ),
    ],
    Some([
      ([(-4, 7, [1, 2, 1, 1])], [0, 1]),
      ([(4, 7, [1, 3, 0, 1])], [0, 2]),
      (
        [(-6, 7, [2, 2, 0, 1]), (1, 4, [0, 1, 2, 1]), (2, 15, [0, 0, 1, 2])],
        [1, 2],
      ),
      (
        [(2, 7, [2, 2, 1, 0]), (-1, 4, [0, 1, 3, 0]), (-2, 15, [0, 0, 2, 1])],
        [1, 3],
      ),
      (
        [(-2, 7, [2, 3, 0, 0]), (1, 4, [0, 2, 2, 0]), (2, 15, [0, 1, 1, 1])],
        [2, 3],
      ),
    ]),
    [
      ([(-4, 1, [1, 2, 0, 1])], [0, 1, 2]),
      (
        [(-2, 1, [2, 2, 0, 0]), (3, 2, [0, 1, 2, 0]), (2, 3, [0, 0, 1, 1])],
        [1, 2, 3],
      ),
    ],
    true,
  )
}

