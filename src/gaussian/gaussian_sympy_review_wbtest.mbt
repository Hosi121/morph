///|
test "independent Sympy Gaussian natural log-partition derivatives through order four" {
  for f in ir_gaussians() {
    let source = gaussian(
      ir_values(f.mean),
      ir_matrix(f.covariance, f.dimension),
    ).unwrap()
    let jet = fisher_jet(source).unwrap()
    assert_eq(@riemann.dimension(jet), @oracle.nat(f.parameters), msg=f.name)
    assert_eq(
      ir_flat_matrix(@riemann.metric(jet)),
      ir_values(f.metric),
      msg=f.name,
    )
    assert_eq(
      ir_flat_first(@riemann.first_derivatives(jet)),
      ir_values(f.first),
      msg=f.name,
    )
    assert_eq(
      ir_flat_second(@riemann.second_derivatives(jet)),
      ir_values(f.second),
      msg=f.name,
    )
  }
}
