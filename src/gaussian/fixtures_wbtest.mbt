      @oracle.chain([@oracle.nat(5), @oracle.nat(0), @oracle.nat(0)]),
    ),
    Ok(fraction("0", false, "1")),
  )
  assert_eq(
    moment(
      source,
      @oracle.chain([@oracle.nat(5), @oracle.nat(0), @oracle.nat(1)]),
    ),
    Ok(fraction("0", false, "1")),
  )
  assert_eq(
    moment(
      source,
      @oracle.chain([@oracle.nat(5), @oracle.nat(1), @oracle.nat(0)]),
    ),
    Ok(fraction("3c", false, "1")),
  )
  assert_eq(
    moment(
      source,
      @oracle.chain([@oracle.nat(6), @oracle.nat(0), @oracle.nat(0)]),
    ),
    Ok(fraction("78", false, "1")),
  )
}
