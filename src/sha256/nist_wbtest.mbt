// NIST CAVP SHA256ShortMsg.rsp, all bit lengths from zero through one block.
// Source SHA256: 3993d9bb135b37f9226420032630f0e34d9b20556160baa9d85546cc421f183e

///|
test "NIST CAVP bit-oriented SHA-256 all short messages" {
