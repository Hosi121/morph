  assert_factor_fixture([2, -1, -2, 3], 1, [([2, -1, -2, 3], 1)])
}

///|
test "SymPy primitive small coefficient grid 393" {
  assert_factor_fixture([2, -1, -1, 3], 1, [([2, -1, -1, 3], 1)])
}

///|
test "SymPy primitive small coefficient grid 394" {
  assert_factor_fixture([2, -1, 0, 3], 1, [([1, 1], 1), ([2, -3, 3], 1)])
}

///|
test "SymPy primitive small coefficient grid 395" {
  assert_factor_fixture([2, -1, 1, 3], 1, [([2, -1, 1, 3], 1)])
}

///|
test "SymPy primitive small coefficient grid 396" {
  assert_factor_fixture([2, -1, 2, 3], 1, [([2, -1, 2, 3], 1)])
}

///|
test "SymPy primitive small coefficient grid 397" {
  assert_factor_fixture([2, 0, -2, 3], 1, [([2, 0, -2, 3], 1)])
}

///|
test "SymPy primitive small coefficient grid 398" {
  assert_factor_fixture([2, 0, -1, 3], 1, [([2, 0, -1, 3], 1)])
}

///|
test "SymPy primitive small coefficient grid 399" {
  assert_factor_fixture([2, 0, 0, 3], 1, [([2, 0, 0, 3], 1)])
}

///|
test "SymPy primitive small coefficient grid 400" {
  assert_factor_fixture([2, 0, 1, 3], 1, [([1, 1], 1), ([2, -2, 3], 1)])
}

///|
test "SymPy primitive small coefficient grid 401" {
  assert_factor_fixture([2, 0, 2, 3], 1, [([2, 0, 2, 3], 1)])
}

///|
test "SymPy primitive small coefficient grid 402" {
  assert_factor_fixture([2, 1, -2, 3], 1, [([2, 1, -2, 3], 1)])
}

///|
test "SymPy primitive small coefficient grid 403" {
  assert_factor_fixture([2, 1, -1, 3], 1, [([2, 3], 1), ([1, -1, 1], 1)])
}

///|
test "SymPy primitive small coefficient grid 404" {
  assert_factor_fixture([2, 1, 0, 3], 1, [([2, 1, 0, 3], 1)])
}

///|
test "SymPy primitive small coefficient grid 405" {
  assert_factor_fixture([2, 1, 1, 3], 1, [([2, 1, 1, 3], 1)])
}

///|
test "SymPy primitive small coefficient grid 406" {
  assert_factor_fixture([2, 1, 2, 3], 1, [([1, 1], 1), ([2, -1, 3], 1)])
}

///|
test "SymPy primitive small coefficient grid 407" {
  assert_factor_fixture([2, 2, -2, 3], 1, [([2, 2, -2, 3], 1)])
}

///|
test "SymPy primitive small coefficient grid 408" {
  assert_factor_fixture([2, 2, -1, 3], 1, [([2, 2, -1, 3], 1)])
}

///|
test "SymPy primitive small coefficient grid 409" {
  assert_factor_fixture([2, 2, 0, 3], 1, [([2, 2, 0, 3], 1)])
}

///|
test "SymPy primitive small coefficient grid 410" {
  assert_factor_fixture([2, 2, 1, 3], 1, [([2, 2, 1, 3], 1)])
}

///|
test "SymPy primitive small coefficient grid 411" {
  assert_factor_fixture([2, 2, 2, 3], 1, [([2, 2, 2, 3], 1)])
}
