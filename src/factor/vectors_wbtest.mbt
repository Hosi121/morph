///|
test "multi-digit rho factors agree with committed Python integer traces" {
  let n = @oracle.binary_from_hex("5f8523f")
  let machine = start(
    n,
    @oracle.binary_from_hex("2"),
    @oracle.binary_from_hex("1"),
  ).unwrap()
  match run(machine, @oracle.nat(39)) {
    Suspended(next) =>
      match step(next) {
        Found(split) => {
          assert_eq(divisor(split), @oracle.binary_from_hex("2717"))
          assert_eq(cofactor(split), @oracle.binary_from_hex("2719"))
          assert_eq(@binary.multiply(divisor(split), cofactor(split)), n)
        }
        _ => abort("expected exact rho transition")
      }
    _ => abort("expected suspension immediately before factor")
  }
  let n = @oracle.binary_from_hex("10000fffafffb")
  let machine = start(
    n,
    @oracle.binary_from_hex("2"),
    @oracle.binary_from_hex("1"),
  ).unwrap()
  match run(machine, @oracle.nat(171)) {
    Suspended(next) =>
      match step(next) {
        Found(split) => {
          assert_eq(divisor(split), @oracle.binary_from_hex("10001"))
          assert_eq(cofactor(split), @oracle.binary_from_hex("fffffffb"))
          assert_eq(@binary.multiply(divisor(split), cofactor(split)), n)
        }
        _ => abort("expected exact rho transition")
      }
    _ => abort("expected suspension immediately before factor")
  }
  let n = @oracle.binary_from_hex("e8d6ca6163")
  let machine = start(
    n,
    @oracle.binary_from_hex("2"),
    @oracle.binary_from_hex("1"),
  ).unwrap()
  match run(machine, @oracle.nat(477)) {
    Suspended(next) =>
      match step(next) {
        Found(split) => {
          assert_eq(divisor(split), @oracle.binary_from_hex("f4261"))
          assert_eq(cofactor(split), @oracle.binary_from_hex("f4243"))
          assert_eq(@binary.multiply(divisor(split), cofactor(split)), n)
        }
        _ => abort("expected exact rho transition")
      }
    _ => abort("expected suspension immediately before factor")
  }
}

///|
test "complete large factorizations require certified prime leaves" {
  let n = @oracle.binary_from_hex("5f8523f")
  let certificates : @core.Chain[@primality.Certificate] = Cons(
    factor_cert_10007(),
    Cons(factor_cert_10009(), Nil),
  )
  let complete = check_factorization(n, certificates).unwrap()
  assert_eq(factorization_value(complete), n)
  assert_eq(
    @core.map(prime_factors(complete), @primality.value),
    Cons(
      @oracle.binary_from_hex("2717"),
      Cons(@oracle.binary_from_hex("2719"), Nil),
    ),
  )
  let n = @oracle.binary_from_hex("10000fffafffb")
  let certificates : @core.Chain[@primality.Certificate] = Cons(
    factor_cert_65537(),
    Cons(factor_cert_4294967291(), Nil),
  )
  let complete = check_factorization(n, certificates).unwrap()
  assert_eq(factorization_value(complete), n)
  assert_eq(
    @core.map(prime_factors(complete), @primality.value),
    Cons(
      @oracle.binary_from_hex("10001"),
      Cons(@oracle.binary_from_hex("fffffffb"), Nil),
    ),
  )
  let n = @oracle.binary_from_hex("e8d6ca6163")
  let certificates : @core.Chain[@primality.Certificate] = Cons(
    factor_cert_1000003(),
    Cons(factor_cert_1000033(), Nil),
  )
  let complete = check_factorization(n, certificates).unwrap()
  assert_eq(factorization_value(complete), n)
  assert_eq(
    @core.map(prime_factors(complete), @primality.value),
    Cons(
      @oracle.binary_from_hex("f4243"),
      Cons(@oracle.binary_from_hex("f4261"), Nil),
    ),
  )
}

///|
test "budgeted recursive rho search completes only with certified leaves" {
  let n = @oracle.binary_from_hex("5f8523f")
  let certificates : @core.Chain[@primality.Certificate] = Cons(
    factor_cert_10007(),
    Cons(factor_cert_10009(), Nil),
  )
  let seeds : @core.Chain[(@binary.Binary, @binary.Binary)] = Cons(
    (@oracle.binary_from_hex("2"), @oracle.binary_from_hex("1")),
    Nil,
  )
  let search = factor_search(n, certificates, seeds).unwrap()
  match search_run(search, @oracle.nat(512)) {
    Complete(complete) => {
      assert_eq(factorization_value(complete), n)
      let factors = @core.map(prime_factors(complete), @primality.value)
      assert_eq(@core.fold_left(factors, @binary.one(), @binary.multiply), n)
    }
    _ => abort("configured prime bank and rho schedule must complete")
  }
  let n = @oracle.binary_from_hex("10000fffafffb")
  let certificates : @core.Chain[@primality.Certificate] = Cons(
    factor_cert_65537(),
    Cons(factor_cert_4294967291(), Nil),
  )
  let seeds : @core.Chain[(@binary.Binary, @binary.Binary)] = Cons(
    (@oracle.binary_from_hex("2"), @oracle.binary_from_hex("1")),
    Nil,
  )
  let search = factor_search(n, certificates, seeds).unwrap()
  match search_run(search, @oracle.nat(512)) {
    Complete(complete) => {
      assert_eq(factorization_value(complete), n)
      let factors = @core.map(prime_factors(complete), @primality.value)
      assert_eq(@core.fold_left(factors, @binary.one(), @binary.multiply), n)
    }
    _ => abort("configured prime bank and rho schedule must complete")
  }
  let n = @oracle.binary_from_hex("e8d6ca6163")
  let certificates : @core.Chain[@primality.Certificate] = Cons(
    factor_cert_1000003(),
    Cons(factor_cert_1000033(), Nil),
  )
  let seeds : @core.Chain[(@binary.Binary, @binary.Binary)] = Cons(
    (@oracle.binary_from_hex("2"), @oracle.binary_from_hex("1")),
    Nil,
  )
  let search = factor_search(n, certificates, seeds).unwrap()
  match search_run(search, @oracle.nat(512)) {
    Complete(complete) => {
      assert_eq(factorization_value(complete), n)
      let factors = @core.map(prime_factors(complete), @primality.value)
      assert_eq(@core.fold_left(factors, @binary.one(), @binary.multiply), n)
    }
    _ => abort("configured prime bank and rho schedule must complete")
  }
}
