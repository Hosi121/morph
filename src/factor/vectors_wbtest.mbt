// Generated by tools/generate_primality.py; Python math.gcd oracle.

///|
test "multi-digit rho factors agree with committed Python integer traces" {
  let n = @oracle.binary_from_hex("5f8523f")
  let machine = start(
    n,
    @oracle.binary_from_hex("2"),
    @oracle.binary_from_hex("1"),
  ).unwrap()
  match run(machine, @oracle.nat(39)) {
    Suspended(next) =>
      match step(next) {
        Found(split) => {
          assert_eq(divisor(split), @oracle.binary_from_hex("2717"))
          assert_eq(cofactor(split), @oracle.binary_from_hex("2719"))
          assert_eq(@binary.multiply(divisor(split), cofactor(split)), n)
        }
        _ => abort("expected exact rho transition")
      }
    _ => abort("expected suspension immediately before factor")
  }
  let n = @oracle.binary_from_hex("10000fffafffb")
  let machine = start(
    n,
    @oracle.binary_from_hex("2"),
    @oracle.binary_from_hex("1"),
  ).unwrap()
  match run(machine, @oracle.nat(171)) {
    Suspended(next) =>
      match step(next) {
        Found(split) => {
          assert_eq(divisor(split), @oracle.binary_from_hex("10001"))
          assert_eq(cofactor(split), @oracle.binary_from_hex("fffffffb"))
          assert_eq(@binary.multiply(divisor(split), cofactor(split)), n)
        }
        _ => abort("expected exact rho transition")
      }
    _ => abort("expected suspension immediately before factor")
  }
  let n = @oracle.binary_from_hex("e8d6ca6163")
  let machine = start(
    n,
    @oracle.binary_from_hex("2"),
    @oracle.binary_from_hex("1"),
  ).unwrap()
  match run(machine, @oracle.nat(477)) {
    Suspended(next) =>
      match step(next) {
        Found(split) => {
          assert_eq(divisor(split), @oracle.binary_from_hex("f4261"))
          assert_eq(cofactor(split), @oracle.binary_from_hex("f4243"))
          assert_eq(@binary.multiply(divisor(split), cofactor(split)), n)
        }
        _ => abort("expected exact rho transition")
      }
    _ => abort("expected suspension immediately before factor")
  }
}
