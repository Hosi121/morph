      {
        members: [0, 1],
        degree: 1,
        basis: [{ real: [(1, 1)], imaginary: [(0, 1)], }],
        generator: { real: [(1, 1)], imaginary: [(0, 1)], },
        minimum: [(-1, 1), (1, 1)],
        generator_coordinates: [(1, 1)],
