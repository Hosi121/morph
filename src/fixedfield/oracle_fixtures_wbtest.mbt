      { real: [(2, 3)], imaginary: [(-3, 5)], },
    ],
    [
      {
        members: [0],
        degree: 2,
        basis: [
          { real: [(1, 1)], imaginary: [(0, 1)], },
          { real: [(0, 1)], imaginary: [(1, 1)], },
        ],
        generator: { real: [(0, 1)], imaginary: [(1, 1)], },
        minimum: [(1, 1), (0, 1), (1, 1)],
        generator_coordinates: [(0, 1), (1, 1)],
        sample_coordinates: [
          Some([(0, 1), (0, 1)]),
          Some([(1, 1), (0, 1)]),
          Some([(0, 1), (1, 1)]),
          Some([(2, 3), (-3, 5)]),
