    ([[1, 0], [0, 1], [3, -1]], [1, 3, 8], [-2, 4], 12, 1),
    ([[1, 0], [0, 1], [-3, 1], [-2, 1], [1, -3]], [1, 2, 7, 5, 4], [2, 1], 4, 1),
    ([[1, 0], [0, 1], [2, 2], [-2, 1], [-2, -2]], [1, 5, 6, 3, 6], [4, 0], 4, 1),
    ([[1, 0], [0, 1], [-3, 0], [0, 3]], [4, 3, 5, 5], [3, 4], 56, 3),
    ([[1, 0], [0, 1], [1, 3], [0, 1], [0, 3]], [3, 2, 8, 8, 5], [0, 4], 20, 3),
    ([[1, 0], [0, 1], [3, 1], [-1, 3], [2, -1]], [3, 5, 2, 2, 1], [1, 3], 14, 5),
    ([[1, 0], [0, 1], [-2, 3], [2, 1]], [1, 1, 3, 0], [4, 3], 0, 1),
    ([[1, 0], [0, 1], [-1, -2], [-2, -3]], [5, 4, 8, 2], [2, 2], 18, 1),
    ([[1, 0], [0, 1], [-3, 0], [0, -3], [2, 3]], [3, 5, 0, 8, 4], [1, 3], 4, 1),
    ([[1, 0], [0, 1], [-3, 3], [-2, 2]], [5, 1, 6, 5], [-2, 2], 2, 1),
    ([[1, 0], [0, 1], [-1, 0], [-3, 0]], [2, 2, 1, 7], [-1, -2], 0, 1),
    ([[1, 0], [0, 1], [2, -3], [-1, 3]], [5, 3, 3, 2], [0, 0], 0, 1),
    ([[1, 0], [0, 1], [-2, -1], [-1, -2]], [1, 1, 2, 8], [0, -1], 0, 1),
    ([[1, 0], [0, 1], [-2, -3], [2, 1]], [4, 3, 3, 8], [-2, 3], 9, 1),
  ]
  for (a, b, c, n, d) in cases {
    let p = make_problem(a, b, c)
    match finish(p) {
      Optimal(result) => {
        assert_true(check_optimum(p, result))
        assert_eq(result.value, @oracle.rational(n, d))
      }
      _ => fail("box-constrained LP must have an optimum")
    }
  }
}
