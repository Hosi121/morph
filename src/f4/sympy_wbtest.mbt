        (-2, 1, [1, 0]),
        (-2, 1, [0, 2]),
        (-1, 1, [0, 1]),
        (-1, 1, [0, 0]),
      ],
    ],
    [[(1, 1, [0, 0])]],
  )
}

///|
test "SymPy rational F4 lex fixture 62" {
  assert_sympy_fixture(
    2,
    [
      [
        (-1, 1, [2, 0]),
        (-2, 1, [1, 1]),
        (-1, 1, [1, 0]),
        (1, 1, [0, 2]),
        (-1, 1, [0, 1]),
        (1, 1, [0, 0]),
      ],
      [
        (-2, 1, [2, 0]),
        (1, 1, [1, 1]),
        (-1, 1, [1, 0]),
        (-1, 1, [0, 2]),
        (-1, 1, [0, 1]),
      ],
    ],
    [
      [
        (1, 1, [1, 0]),
        (35, 29, [0, 3]),
        (43, 29, [0, 2]),
        (13, 58, [0, 1]),
        (9, 58, [0, 0]),
      ],
      [(1, 1, [0, 4]), (10, 7, [0, 3]), (13, 14, [0, 2]), (5, 14, [0, 0])],
    ],
  )
}
