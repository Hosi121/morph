    (Nil, Cons(false, Cons(true, Cons(true, Cons(true, Nil))))) =>
      tiny_product_value_0
    (Nil, Cons(true, Cons(true, Cons(true, Cons(true, Nil))))) =>
      tiny_product_value_0
    (Cons(true, Nil), Nil) => tiny_product_value_0
