///|
fn radix_4_shared_split(n : @core.Nat) -> (@core.Nat, Bool, Bool) {
  fn walk(fast : @core.Nat, slow : @core.Nat) -> (@core.Nat, Bool, Bool) {
    match (fast, slow) {
      (Zero, tail) => (tail, false, false)
      (Succ(Zero), Succ(tail)) => (tail, true, false)
      (Succ(Succ(Zero)), Succ(Succ(tail))) => (tail, false, true)
      (Succ(Succ(Succ(Zero))), Succ(Succ(Succ(tail)))) => (tail, true, true)
      (Succ(Succ(Succ(Succ(rest)))), Succ(Succ(Succ(tail)))) => walk(rest, tail)
      _ => (Zero, false, false)
    }
  }
  walk(n, n)
}

///|
fn radix_4_shared(n : @core.Nat) -> Binary {
  fn convert(n : @core.Nat) -> @core.Chain[Bool] {
    match n {
      Zero => Nil
      Succ(_) => {
        let (q, b0, b1) = radix_4_shared_split(n)
        low_bit(b0, low_bit(b1, convert(q)))
      }
    }
  }
  { bits: convert(n), }
}

///|
fn radix_4_rebuild_split(n : @core.Nat) -> (@core.Nat, Bool, Bool) {
  fn walk(fast : @core.Nat, slow : @core.Nat) -> (@core.Nat, Bool, Bool) {
    match fast {
      Zero => (slow, false, false)
      Succ(Zero) => (slow, true, false)
      Succ(Succ(Zero)) => (slow, false, true)
      Succ(Succ(Succ(Zero))) => (slow, true, true)
      Succ(Succ(Succ(Succ(rest)))) => walk(rest, Succ(slow))
    }
  }
  walk(n, Zero)
}

