///|
test "radix candidates agree with an independent integer conversion oracle" {
  let candidates = [
    radix_4_shared, radix_4_rebuild, radix_8_shared, radix_8_rebuild, radix_16_shared,
    radix_16_rebuild,
  ]
  for value in 0..<=1024 {
    let n = @oracle.nat(value)
    let expected = @oracle.binary(value)
    for convert in candidates {
      assert_eq(convert(n), expected)
    }
  }
  for value in [4095, 4096, 4097, 65535, 65536, 65537, 100000] {
    let n = @oracle.nat(value)
    let expected = @oracle.binary(value)
    for convert in candidates {
      assert_eq(convert(n), expected)
    }
  }
}

///|
test "grouping unary input into several bits at a time" (b : @bench.T) {
  for value in [4096, 100000] {
    let n = @oracle.nat(value)
    b.bench(name="two shared \{value}", fn() { b.keep(shared_nat_binary(n)) })
    b.bench(name="two rebuild \{value}", fn() {
      b.keep(rebuilding_nat_binary(n))
    })
    b.bench(name="radix_4_shared \{value}", fn() { b.keep(radix_4_shared(n)) })
    b.bench(name="radix_4_rebuild \{value}", fn() { b.keep(radix_4_rebuild(n)) })
    b.bench(name="radix_8_shared \{value}", fn() { b.keep(radix_8_shared(n)) })
    b.bench(name="radix_8_rebuild \{value}", fn() { b.keep(radix_8_rebuild(n)) })
    b.bench(name="radix_16_shared \{value}", fn() { b.keep(radix_16_shared(n)) })
    b.bench(name="radix_16_rebuild \{value}", fn() {
      b.keep(radix_16_rebuild(n))
    })
  }
}
