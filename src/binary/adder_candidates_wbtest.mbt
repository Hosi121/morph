// Generated by tools/generate_adder_candidates.py; test-only candidates.

///|
fn candidate_0(a : Bool, b : Bool, carry : Bool) -> (Bool, Bool) {
  match a {
    false =>
      match b {
        false => (carry, false)
        true => (!carry, carry)
      }
    true =>
      match b {
        false => (!carry, carry)
        true => (carry, true)
      }
  }
}

///|
fn candidate_bits_0(
  xs : @core.Chain[Bool],
  ys : @core.Chain[Bool],
  carry : Bool,
) -> @core.Chain[Bool] {
  match (xs, ys) {
    (Cons(a, xs), Cons(b, ys)) => {
      let (sum, next) = candidate_0(a, b, carry)
      Cons(sum, candidate_bits_0(xs, ys, next))
    }
    (rest, Nil) | (Nil, rest) =>
      match carry {
        false => rest
        true => increment_bits(rest)
      }
  }
}

