  assert_eq(candidate_11(true, true, false), full_adder(true, true, false))
  assert_eq(candidate_0(true, true, true), full_adder(true, true, true))
  assert_eq(candidate_1(true, true, true), full_adder(true, true, true))
  assert_eq(candidate_2(true, true, true), full_adder(true, true, true))
  assert_eq(candidate_3(true, true, true), full_adder(true, true, true))
  assert_eq(candidate_4(true, true, true), full_adder(true, true, true))
  assert_eq(candidate_5(true, true, true), full_adder(true, true, true))
  assert_eq(candidate_6(true, true, true), full_adder(true, true, true))
  assert_eq(candidate_7(true, true, true), full_adder(true, true, true))
  assert_eq(candidate_8(true, true, true), full_adder(true, true, true))
  assert_eq(candidate_9(true, true, true), full_adder(true, true, true))
  assert_eq(candidate_10(true, true, true), full_adder(true, true, true))
  assert_eq(candidate_11(true, true, true), full_adder(true, true, true))
  for seed in 0..<128 {
    let left = @oracle.binary(seed * 127 + 3)
    let right = @oracle.binary(seed * 59 + 7)
    let expected = @oracle.binary(seed * 186 + 10)
    assert_eq(
      Binary::{ bits: candidate_bits_0(left.bits, right.bits, false), },
      expected,
    )
    assert_eq(
      Binary::{ bits: candidate_bits_1(left.bits, right.bits, false), },
      expected,
    )
    assert_eq(
      Binary::{ bits: candidate_bits_2(left.bits, right.bits, false), },
      expected,
    )
    assert_eq(
      Binary::{ bits: candidate_bits_3(left.bits, right.bits, false), },
      expected,
    )
    assert_eq(
      Binary::{ bits: candidate_bits_4(left.bits, right.bits, false), },
      expected,
    )
    assert_eq(
      Binary::{ bits: candidate_bits_5(left.bits, right.bits, false), },
      expected,
    )
    assert_eq(
      Binary::{ bits: candidate_bits_6(left.bits, right.bits, false), },
      expected,
    )
    assert_eq(
      Binary::{ bits: candidate_bits_7(left.bits, right.bits, false), },
      expected,
    )
    assert_eq(
      Binary::{ bits: candidate_bits_8(left.bits, right.bits, false), },
      expected,
    )
    assert_eq(
      Binary::{ bits: candidate_bits_9(left.bits, right.bits, false), },
      expected,
    )
    assert_eq(
      Binary::{ bits: candidate_bits_10(left.bits, right.bits, false), },
      expected,
    )
    assert_eq(
      Binary::{ bits: candidate_bits_11(left.bits, right.bits, false), },
      expected,
    )
  }
}

///|
test "cofactor addition candidates at 256 bits" (b : @bench.T) {
  let left = @oracle.chain(
    Array::makei(256, fn(i) { i == 255 || (i * 17 + 3) % 11 < 6 }),
  )
  let right = @oracle.chain(
    Array::makei(256, fn(i) { i == 255 || (i * 13 + 7) % 7 < 4 }),
  )
  b.bench(name="reference", fn() { b.keep(add_bits(left, right, false)) })
  b.bench(name="candidate 0: 011", fn() {
    b.keep(candidate_bits_0(left, right, false))
  })
  b.bench(name="candidate 1: 012", fn() {
    b.keep(candidate_bits_1(left, right, false))
  })
  b.bench(name="candidate 2: 021", fn() {
    b.keep(candidate_bits_2(left, right, false))
  })
  b.bench(name="candidate 3: 022", fn() {
    b.keep(candidate_bits_3(left, right, false))
  })
  b.bench(name="candidate 4: 100", fn() {
    b.keep(candidate_bits_4(left, right, false))
  })
  b.bench(name="candidate 5: 102", fn() {
    b.keep(candidate_bits_5(left, right, false))
  })
  b.bench(name="candidate 6: 120", fn() {
    b.keep(candidate_bits_6(left, right, false))
  })
  b.bench(name="candidate 7: 122", fn() {
    b.keep(candidate_bits_7(left, right, false))
  })
  b.bench(name="candidate 8: 200", fn() {
    b.keep(candidate_bits_8(left, right, false))
  })
  b.bench(name="candidate 9: 201", fn() {
    b.keep(candidate_bits_9(left, right, false))
  })
  b.bench(name="candidate 10: 210", fn() {
    b.keep(candidate_bits_10(left, right, false))
  })
  b.bench(name="candidate 11: 211", fn() {
    b.keep(candidate_bits_11(left, right, false))
  })
}

