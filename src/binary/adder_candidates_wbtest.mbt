  assert_eq(candidate_1(true, true, false), full_adder(true, true, false))
  assert_eq(candidate_2(true, true, false), full_adder(true, true, false))
  assert_eq(candidate_3(true, true, false), full_adder(true, true, false))
  assert_eq(candidate_4(true, true, false), full_adder(true, true, false))
  assert_eq(candidate_5(true, true, false), full_adder(true, true, false))
