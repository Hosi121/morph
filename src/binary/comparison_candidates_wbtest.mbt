///|
fn comparison_plain(
  xs : @core.Chain[Bool],
  ys : @core.Chain[Bool],
) -> @core.Ordering {
  fn walk(
    xs : @core.Chain[Bool],
    ys : @core.Chain[Bool],
    previous : @core.Ordering,
  ) -> @core.Ordering {
    match (xs, ys) {
      (Nil, Nil) => previous
      (Nil, Cons(_, _)) => Less
      (Cons(_, _), Nil) => Greater
      (Cons(x, xt), Cons(y, yt)) => {
        let next : @core.Ordering = match (x, y) {
          (false, true) => Less
          (true, false) => Greater
          _ => previous
        }
        walk(xt, yt, next)
      }
    }
  }
  walk(xs, ys, Equal)
}

