///|
fn candidate_difference_full_lookup(a : Binary, b : Binary) -> Binary?? {
  match a.bits {
    Cons(_, Cons(_, Cons(_, Cons(_, Cons(_, _))))) => None
    _ =>
      match b.bits {
        Cons(_, Cons(_, Cons(_, Cons(_, Cons(_, _))))) => None
        _ => candidate_difference_full_table(a, b)
      }
  }
}

///|
fn candidate_difference_reference(a : Binary, b : Binary) -> Binary? {
  match compare(a, b) {
    Less => None
    _ => Some(from_bits(subtract_bits(a.bits, b.bits, false)))
  }
}

///|
fn candidate_difference_equal_control(a : Binary, b : Binary) -> Binary? {
  match compare(a, b) {
    Less => None
    Equal => tiny_product_value_0
    Greater => Some(from_bits(subtract_bits(a.bits, b.bits, false)))
  }
}

///|
fn candidate_difference_ordered_control(a : Binary, b : Binary) -> Binary? {
  match (a.bits, b.bits) {
    (_, Nil) => return Some(a)
    (Nil, _) => return None
    _ => ()
  }
  match compare(a, b) {
    Less => None
    Equal => tiny_product_value_0
    Greater => {
      let known = candidate_difference_ordered_lookup(a, b)
      match known {
        Some(_) => known
        None => Some(from_bits(subtract_bits(a.bits, b.bits, false)))
      }
    }
  }
}

///|
fn candidate_difference_full_control(a : Binary, b : Binary) -> Binary? {
  match (a.bits, b.bits) {
    (_, Nil) => return Some(a)
    (Nil, _) => return None
    _ => ()
  }
  match candidate_difference_full_lookup(a, b) {
    Some(result) => result
    None =>
      match compare(a, b) {
        Less => None
        Equal => tiny_product_value_0
        Greater => Some(from_bits(subtract_bits(a.bits, b.bits, false)))
      }
  }
}

///|
test "difference dispatches and partial maps match independent byte differences" {
  for a in 0..<256 {
    for b in 0..<256 {
      let x = @oracle.binary(a)
      let y = @oracle.binary(b)
      let expected = if a < b { None } else { Some(@oracle.binary(a - b)) }
      assert_eq(candidate_difference_ordered_control(x, y), expected)
      assert_eq(candidate_difference_full_control(x, y), expected)
      let ordered = if a < 16 && b < 16 && a > b { expected } else { None }
      let full = if a < 16 && b < 16 { Some(expected) } else { None }
      assert_eq(candidate_difference_ordered_lookup(x, y), ordered)
      assert_eq(candidate_difference_full_lookup(x, y), full)
    }
  }
}

///|
test "same ELF difference order controls for nonzero small words" (b : @bench.T) {
  let pairs = []
  for a in 1..<16 {
    for c in 1..<16 {
      pairs.push((@oracle.binary(a), @oracle.binary(c)))
    }
  }
  b.bench(name="original small225", fn() {
    for pair in pairs {
      b.keep(candidate_difference_reference(pair.0, pair.1))
    }
  })
  b.bench(name="equal fast small225", fn() {
    for pair in pairs {
      b.keep(candidate_difference_equal_control(pair.0, pair.1))
    }
  })
  b.bench(name="compare first small225", fn() {
    for pair in pairs {
      b.keep(candidate_difference_ordered_control(pair.0, pair.1))
    }
  })
  b.bench(name="lookup first small225", fn() {
    for pair in pairs {
      b.keep(candidate_difference_full_control(pair.0, pair.1))
    }
  })
}

///|
test "same ELF difference byte fallback controls" (b : @bench.T) {
  let pairs = []
  for index in 0..<128 {
    pairs.push(
      (
        @oracle.binary((index * 73 + 19) % 256),
        @oracle.binary((index * 137 + 43) % 256),
      ),
    )
  }
  b.bench(name="original byte128", fn() {
    for pair in pairs {
      b.keep(candidate_difference_reference(pair.0, pair.1))
    }
  })
  b.bench(name="compare first byte128", fn() {
    for pair in pairs {
      b.keep(candidate_difference_ordered_control(pair.0, pair.1))
    }
  })
  b.bench(name="lookup first byte128", fn() {
    for pair in pairs {
      b.keep(candidate_difference_full_control(pair.0, pair.1))
    }
  })
}

///|
test "same ELF difference wide and identity controls" (b : @bench.T) {
  let a = @oracle.binary_from_hex("d59b8c50c9174c3a71293ab167cd89ef")
  let c = @oracle.binary_from_hex("21234567a789cf1323456789abcdef01")
  let small = @oracle.binary(11)
  let pairs = [
    (a, c),
    (c, a),
    (a, small),
    (small, a),
    (a, a),
    (zero(), a),
    (a, zero()),
  ]
  b.bench(name="original wide7", fn() {
    for pair in pairs {
      b.keep(candidate_difference_reference(pair.0, pair.1))
    }
  })
  b.bench(name="compare first wide7", fn() {
    for pair in pairs {
      b.keep(candidate_difference_ordered_control(pair.0, pair.1))
    }
  })
  b.bench(name="lookup first wide7", fn() {
    for pair in pairs {
      b.keep(candidate_difference_full_control(pair.0, pair.1))
    }
  })
}
