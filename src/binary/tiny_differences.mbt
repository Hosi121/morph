///|
fn difference_full_lookup(a : Binary, b : Binary) -> Binary?? {
  match a.bits {
    Cons(_, Cons(_, Cons(_, Cons(_, Cons(_, _))))) => None
    _ =>
      match b.bits {
        Cons(_, Cons(_, Cons(_, Cons(_, Cons(_, _))))) => None
        _ => difference_full_table(a, b)
      }
  }
}

///|
fn subtract_adaptively(a : Binary, b : Binary) -> Binary? {
  match (a.bits, b.bits) {
    (_, Nil) => return Some(a)
    (Nil, _) => return None
    _ => ()
  }
  match difference_full_lookup(a, b) {
    Some(result) => result
    None =>
      match compare(a, b) {
        Less => None
        Equal => tiny_product_value_0
        Greater => Some(from_bits(subtract_bits(a.bits, b.bits, false)))
      }
  }
}
