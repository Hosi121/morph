      elimination_rat(false, "1", "3"),
      elimination_rat(false, "2", "3"),
    ]),
    @berkowitz.rationals(),
  )
  let expected = elimination_rat(false, "44", "51")
  assert_eq(discriminant(f, @berkowitz.rationals()), Some(expected))
  assert_true(
    check_discriminant(f, expected, @berkowitz.rationals(), fn(a, b) { a == b }),
  )
}

