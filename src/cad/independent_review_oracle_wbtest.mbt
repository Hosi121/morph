// Independent closed-form oracle, exact Fraction grid; generated by tools/generate_cad_review.py.

///|
test "independent CAD closed form 0 inverse" {
  review_qe_fixture(
    2,
    1,
    @qf.Atom(review_poly(2, [(1, 1, [1, 1]), (-1, 1, [0, 0])]), @qf.EqualZero),
    @oracle.chain([@logic.Quantifier::Exists]),
    [
      ([(-3, 1)], true),
      ([(-2, 1)], true),
      ([(-1, 1)], true),
      ([(0, 1)], false),
      ([(1, 1)], true),
      ([(2, 1)], true),
      ([(3, 1)], true),
      ([(1, 4)], true),
      ([(-1, 4)], true),
      ([(1, 2)], true),
      ([(3, 2)], true),
      ([(-3, 2)], true),
    ],
  )
}

