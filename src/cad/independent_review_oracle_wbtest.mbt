///|
test "independent CAD closed form 13 nonlinear_shared_content" {
  review_qe_fixture(
    3,
    2,
    @qf.Conjunction(
      @qf.Atom(
        review_poly(3, [
          (-1, 1, [1, 0, 1]),
          (1, 1, [1, 0, 0]),
          (1, 1, [0, 2, 1]),
          (-1, 1, [0, 2, 0]),
        ]),
        @qf.EqualZero,
      ),
      @qf.Atom(
        review_poly(3, [
          (-1, 1, [1, 0, 1]),
          (-1, 1, [1, 0, 0]),
          (1, 1, [0, 2, 1]),
          (1, 1, [0, 2, 0]),
        ]),
        @qf.EqualZero,
      ),
    ),
    @oracle.chain([@logic.Quantifier::Exists]),
    [
      ([(-2, 1), (-1, 1)], false),
      ([(-2, 1), (-1, 2)], false),
      ([(-2, 1), (0, 1)], false),
      ([(-2, 1), (1, 2)], false),
      ([(-2, 1), (1, 1)], false),
      ([(-1, 1), (-1, 1)], false),
      ([(-1, 1), (-1, 2)], false),
      ([(-1, 1), (0, 1)], false),
      ([(-1, 1), (1, 2)], false),
      ([(-1, 1), (1, 1)], false),
      ([(0, 1), (-1, 1)], false),
      ([(0, 1), (-1, 2)], false),
      ([(0, 1), (0, 1)], true),
      ([(0, 1), (1, 2)], false),
      ([(0, 1), (1, 1)], false),
      ([(1, 2), (-1, 1)], false),
      ([(1, 2), (-1, 2)], false),
      ([(1, 2), (0, 1)], false),
      ([(1, 2), (1, 2)], false),
      ([(1, 2), (1, 1)], false),
      ([(1, 1), (-1, 1)], true),
      ([(1, 1), (-1, 2)], false),
      ([(1, 1), (0, 1)], false),
      ([(1, 1), (1, 2)], false),
      ([(1, 1), (1, 1)], true),
      ([(2, 1), (-1, 1)], false),
      ([(2, 1), (-1, 2)], false),
      ([(2, 1), (0, 1)], false),
      ([(2, 1), (1, 2)], false),
      ([(2, 1), (1, 1)], false),
    ],
  )
}

