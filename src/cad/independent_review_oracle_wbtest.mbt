      ([(1, 1)], true),
      ([(2, 1)], true),
      ([(3, 1)], true),
      ([(1, 4)], true),
      ([(-1, 4)], false),
      ([(1, 2)], true),
      ([(3, 2)], true),
      ([(-3, 2)], false),
