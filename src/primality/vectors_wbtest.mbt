///|
test "multi-digit certified primes from independent Python witnesses" {
  assert_eq(check(cert_257()).map(value), Some(@oracle.binary_from_hex("101")))
  assert_eq(
    check(cert_65537()).map(value),
    Some(@oracle.binary_from_hex("10001")),
  )
  assert_eq(
    check(cert_998244353()).map(value),
    Some(@oracle.binary_from_hex("3b800001")),
  )
  assert_eq(
    check(cert_2147483647()).map(value),
    Some(@oracle.binary_from_hex("7fffffff")),
  )
  assert_eq(
    check(cert_2305843009213693951()).map(value),
    Some(@oracle.binary_from_hex("1fffffffffffffff")),
  )
}
